---
/*
  /using-data-to-build-with-ai: how birthday-cards.ai runs on its own data, with
  the live dashboard at the top. Linked from the homepage module ("How I built
  it") and the birthday-cards case study. Copy lives in src/data/how-data.ts.
  The dashboard reuses StatGrid, MonthlyCards, and CountryMap (open), so the
  homepage and this page read the same snapshots and cannot disagree.

  Build-time guards: a paragraph or FAQ answer with a numeral other than a
  four-digit year throws unless it is flagged numerals: "dated-fact" with a
  source (the site law: traffic numbers are never typed). Since S30 (9/21/26)
  everything under the numbers is a blog post in Gabriel's own words: plain
  headings, paragraphs, three simple graphics (ToolStrip, SearchGrowth,
  MethodMix) with a caption each, signed -Gabe. Every tool named in
  how-data.ts `tools` renders bold wherever a post paragraph mentions it. The
  post's word count is printed every build (band 450 to 650, a throw above 700).
*/
import BaseLayout from "../layouts/BaseLayout.astro";
import StatGrid from "../components/StatGrid.astro";
import MonthlyCards from "../components/MonthlyCards.astro";
import CountryMap from "../components/CountryMap.astro";
import { getBcStats } from "../lib/bcStats";
import { bcStatsSource, siteUrl } from "../config/site";
import ToolStrip from "../components/ToolStrip.astro";
import MethodMix from "../components/MethodMix.astro";
import SearchGrowth from "../components/SearchGrowth.astro";
import { meta, sources, post, captions, tools, faq, namedTokens, video, type Paragraph, type Block, type Figure } from "../data/how-data";
import LoopVideo from "../components/LoopVideo.astro";
import SystemMap from "../components/SystemMap.astro";

const s = await getBcStats();
const fmt = (n: number) => n.toLocaleString("en-US");
const longDate = (iso: string) =>
  new Date(`${iso}T12:00:00Z`).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" });

const text = (p: Paragraph) => (typeof p === "string" ? p : p.text);
const hasStrayNumeral = (t: string) => {
  let stripped = t.replace(/\b(19|20)\d{2}\b/g, "");
  for (const token of namedTokens) stripped = stripped.split(token).join("");
  return /\d/.test(stripped);
};

// S30 guard: every paragraph, caption and heading of the post is checked.
// Numerals pass only inside a dated-fact paragraph with a source; headings
// carry no commas; the post band is 450 to 650 words, a throw above 700.
const isFigure = (b: Block): b is Figure => typeof b !== "string" && "figure" in b;
const guardText = (where: string, p: Paragraph) => {
  const flagged = typeof p !== "string" && p.numerals === "dated-fact" && p.source.trim().length > 0;
  if (hasStrayNumeral(text(p)) && !flagged) {
    throw new Error(`[how-data] numeral in prose without a dated-fact source (${where}): "${text(p).slice(0, 60)}"`);
  }
};
for (const sec of post) {
  if (sec.heading.includes(",")) throw new Error(`[how-data] heading with a comma: "${sec.heading}"`);
  guardText(sec.id, sec.heading);
  for (const b of sec.blocks) if (!isFigure(b)) guardText(sec.id, b);
}
for (const [k, c] of Object.entries(captions)) guardText(`captions/${k}`, c);
for (const f of faq) {
  if (hasStrayNumeral(f.a) || hasStrayNumeral(f.q)) throw new Error(`[how-data] numeral in the FAQ: "${f.q}"`);
}

const searchLine = `In the last ${s.window_days} days ${fmt(s.search_visitors_30d)} of ${fmt(s.visitors_30d)} visitors came from a search engine.`;

// Every tool name renders bold wherever a post paragraph mentions it. The
// paragraph is escaped first, then the names are wrapped, longest first so
// "Vercel Web Analytics" wins over "Vercel". A listed tool the post never
// mentions is a throw, so the strip and the prose cannot disagree.
const esc = (t: string) => t.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
const reEsc = (t: string) => t.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
const toolNames = tools.map((t) => t.name).sort((a, b) => b.length - a.length);
const toolRe = new RegExp(`(?<![\\w])(${toolNames.map((n) => reEsc(esc(n))).join("|")})(?![\\w])`, "g");
const bold = (t: string) => esc(t).replace(toolRe, '<strong class="font-medium text-white">$1</strong>');

const postParagraphs = post.flatMap((sec) => sec.blocks.filter((b): b is Paragraph => !isFigure(b)).map(text));
const postText = postParagraphs.join(" ");
const unmentioned = tools.filter((t) => !new RegExp(`(?<![\\w])${reEsc(t.name)}(?![\\w])`).test(postText));
if (unmentioned.length) throw new Error(`[how-data] tools never mentioned in the post: ${unmentioned.map((t) => t.name).join(", ")}`);
const boldCount = (bold(postText).match(/<strong /g) ?? []).length;

const words = (t: string) => t.split(/\s+/).filter(Boolean).length;
const postWords = words([postText, searchLine, ...Object.values(captions)].join(" "));
const wordCount = postWords + words([meta.lede, ...faq.flatMap((f) => [f.q, f.a])].join(" "));
if (postWords > 700) throw new Error(`[how-data] the post is ${postWords} words, above the 700 cap`);
console.log(`[how-data] post ${postWords} words (450 to 650), page ${wordCount}, ${post.length} sections, ${tools.length} tools all mentioned, ${boldCount} bold mentions, ${faq.length} FAQ`);

const url = `${siteUrl}/using-data-to-build-with-ai/`;
const ld = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "@id": `${url}#post`,
    headline: meta.title,
    description: meta.description,
    url,
    mainEntityOfPage: url,
    datePublished: meta.published,
    dateModified: meta.modified,
    inLanguage: "en",
    wordCount,
    author: { "@id": `${siteUrl}/#person` },
    publisher: { "@id": `${siteUrl}/#organization` },
    about: {
      "@type": "SoftwareApplication",
      name: "birthday-cards.ai",
      url: bcStatsSource.productUrl,
      applicationCategory: "DesignApplication"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "VideoObject",
    "@id": `${url}#video`,
    name: video.name,
    description: video.description,
    thumbnailUrl: `${siteUrl}${video.poster}`,
    contentUrl: `${siteUrl}${video.src}`,
    uploadDate: video.uploadDate,
    duration: `PT${video.seconds}S`,
    inLanguage: "en",
    isPartOf: { "@id": `${url}#post` }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${url}#faq`,
    mainEntity: faq.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a }
    }))
  }
];
---
<BaseLayout title={meta.title} description={meta.description} ogImage={`${siteUrl}/images/og-using-data.png`}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(ld)} />

  <section class="pt-32 pb-10 md:pt-40 md:pb-12 px-6 md:px-12 lg:px-16">
    <div class="max-w-7xl mx-auto grid lg:grid-cols-12 gap-8">
      <div class="lg:col-span-8">
        <span class="label block mb-4">{meta.eyebrow}</span>
        <h1 class="heading-display text-4xl md:text-5xl text-white">{meta.title}</h1>
        <p class="mt-6 text-surface-400 text-base md:text-lg leading-relaxed max-w-xl">{meta.lede}</p>
      </div>
    </div>
  </section>

  <section id="numbers" class="px-6 md:px-12 lg:px-16 pb-16 md:pb-20 border-b border-white/[0.06]" aria-labelledby="numbers-heading">
    <div class="max-w-7xl mx-auto">
      <div class="max-w-3xl">
        <h2 id="numbers-heading" class="font-mono text-[11px] tracking-[0.15em] text-gold-500 mb-5">The numbers as of today</h2>
        <StatGrid stats={s} />
        <MonthlyCards />
        <CountryMap open />
        <p class="mt-5 text-xs text-surface-500 leading-relaxed">
          Refreshed {longDate(s.fetched_at)} from {bcStatsSource.label}. Test traffic excluded.
        </p>
        <ul class="mt-4 flex flex-wrap gap-2" aria-label="Connected sources">
          {sources.map((src) => (
            <li class="border border-white/[0.08] px-2 py-1 font-mono text-[11px] tracking-[0.05em] text-surface-400">{src}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="px-6 md:px-12 lg:px-16 py-16 md:py-24 border-b border-white/[0.06]">
    <div class="max-w-7xl mx-auto">
      <div class="max-w-3xl">
        {post.map((sec, i) => (
          <section id={sec.id} class={i === 0 ? "" : "mt-14"} aria-labelledby={`${sec.id}-heading`}>
            <h2 id={`${sec.id}-heading`} class="heading-display text-2xl md:text-3xl text-white">{sec.heading}</h2>
            {sec.blocks.map((b) =>
              isFigure(b) ? (
                b.figure === "searchLine" ? (
                  <p class="mt-5 text-surface-200 leading-relaxed max-w-2xl">{searchLine}</p>
                ) : (
                  <div class="mt-8 mb-8">
                    {b.figure === "tools" && <ToolStrip />}
                    {b.figure === "growth" && <SearchGrowth />}
                    {b.figure === "methods" && <MethodMix />}
                    {b.figure === "video" && <LoopVideo />}
                    {b.figure === "map" && <SystemMap />}
                    <p class="mt-3 text-[13px] leading-snug text-surface-400">{captions[b.figure]}</p>
                  </div>
                )
              ) : (
                <p class="mt-5 text-surface-200 leading-relaxed max-w-2xl" set:html={bold(text(b))} />
              )
            )}
          </section>
        ))}

        <section id="faq" class="mt-14 pt-10 border-t border-white/[0.06]" aria-labelledby="faq-heading">
          <h2 id="faq-heading" class="font-mono text-[11px] tracking-[0.15em] text-gold-500 mb-5">Questions</h2>
          {faq.map((f) => (
            <div class="mt-5 max-w-2xl">
              <h3 class="text-white font-medium">{f.q}</h3>
              <p class="mt-2 text-surface-300 leading-relaxed">{f.a}</p>
            </div>
          ))}
        </section>
      </div>
    </div>
  </section>

  <section class="px-6 md:px-12 lg:px-16 py-16 md:py-20">
    <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-6">
      <p class="text-surface-400">Working on something like this?</p>
      <div class="flex flex-wrap gap-x-8 gap-y-3">
        <a href="/#contact" class="group inline-flex items-center gap-2 text-sm text-white font-medium hover:text-gold-500 transition-colors">
          <span>Email me</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-1" aria-hidden="true"><path d="M5 12h14m-7-7l7 7-7 7" /></svg>
        </a>
        <a href={bcStatsSource.productUrl} target="_blank" rel="noreferrer" class="text-sm text-surface-300 hover:text-gold-500 transition-colors">Open birthday-cards.ai</a>
        <a href="/" class="text-sm text-surface-300 hover:text-gold-500 transition-colors">Back to the homepage</a>
      </div>
    </div>
  </section>
</BaseLayout>
