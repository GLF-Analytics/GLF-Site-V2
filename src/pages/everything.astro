---
/*
  /everything: the long list. Not in the nav; linked from the About block and
  the row under the case studies on the homepage. Copy lives in
  src/data/everything.ts. The word cloud is computed here from that copy:
  each term's font size follows how often it appears across the forty
  bullets (square-root scale so the big words do not drown the rest), the
  top term is gold, and the build throws if a term scores zero or the list
  is not forty long. The bullets render in runs: consecutive bullets with the
  same project sit under one mono heading with an id, so /everything#bartaco
  lands on that run. No data-reveal on this page: forty hidden bullets is
  the worst case for the reveal observer, so everything renders plainly.
*/
import BaseLayout from "../layouts/BaseLayout.astro";
import { intro, bullets, cloudTerms } from "../data/everything";

if (bullets.length !== 40) {
  throw new Error(`/everything expects 40 bullets, found ${bullets.length}`);
}

// Runs: consecutive bullets that share a project render under one heading.
// Order is the data file's order; a project that appears twice (GLF Analytics
// in 2021 and again now) simply gets two runs. Build throws on an empty label.
type Run = { project: string; id: string; items: typeof bullets };
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
const runs: Run[] = [];
for (const b of bullets) {
  if (!b.project.trim()) throw new Error(`/everything bullet with no project: "${b.text.slice(0, 40)}"`);
  const last = runs[runs.length - 1];
  if (last && last.project === b.project) last.items.push(b);
  else runs.push({ project: b.project, id: slug(b.project), items: [b] });
}
const ids = runs.map((r) => r.id);
const dupIds = ids.filter((id, i) => ids.indexOf(id) !== i);
runs.forEach((r, i) => { if (dupIds.includes(r.id)) r.id = `${r.id}-${i + 1}`; });

const corpus = bullets.map((b) => `${b.text} ${b.tools.join(" ")}`).join("\n");
const escapeRegExp = (s: string) => s.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");

const scored = cloudTerms.map((term) => {
  const pattern = term.pattern ?? new RegExp(`\\b${escapeRegExp(term.label)}`, "gi");
  const count = (corpus.match(pattern) ?? []).length;
  return { label: term.label, count };
});

const zero = scored.filter((t) => t.count === 0).map((t) => t.label);
if (zero.length) {
  throw new Error(`/everything cloud terms with no matches: ${zero.join(", ")}`);
}

const maxCount = Math.max(...scored.map((t) => t.count));
const minRem = 0.8;
const maxRem = 3.4;
const sized = scored.map((t) => {
  const ratio = Math.sqrt(t.count / maxCount);
  const rem = minRem + (maxRem - minRem) * ratio;
  const tone =
    t.count === maxCount ? "text-gold-500"
    : ratio >= 0.62 ? "text-white"
    : ratio >= 0.42 ? "text-surface-300"
    : "text-surface-500";
  const weight = ratio >= 0.42 ? "font-medium" : "font-normal";
  return { ...t, rem: Number(rem.toFixed(2)), tone, weight };
});

// Deterministic scatter so the big words are spread through the block
// instead of sorted into a ranked list. Same seed every build.
let seed = 20260908;
const rand = () => {
  seed = (seed * 1103515245 + 12345) % 2147483648;
  return seed / 2147483648;
};
const cloud = [...sized];
for (let i = cloud.length - 1; i > 0; i--) {
  const j = Math.floor(rand() * (i + 1));
  [cloud[i], cloud[j]] = [cloud[j], cloud[i]];
}

console.log(`[everything] ${runs.length} groups: ` + runs.map((r) => `${r.project} ${r.items.length}`).join(", "));
console.log(
  "[everything] cloud counts: " +
    [...scored].sort((a, b) => b.count - a.count).map((t) => `${t.label} ${t.count}`).join(", ")
);

const description =
  "Forty things Gabriel Freeman has done since 2017, from brand lift studies and BigQuery warehouses to delivery growth for a 34-market restaurant group and an AI product built with Claude Code. Tools named on every line.";
---
<BaseLayout title={intro.title} description={description}>
  <section class="pt-32 pb-12 md:pt-40 md:pb-16 px-6 md:px-12 lg:px-16">
    <div class="max-w-7xl mx-auto grid lg:grid-cols-12 gap-8">
      <div class="lg:col-span-8">
        <span class="label block mb-4">{intro.eyebrow}</span>
        <h1 class="heading-display text-4xl md:text-5xl text-white">{intro.title}</h1>
        <p class="mt-6 text-surface-400 text-base md:text-lg leading-relaxed max-w-xl">{intro.lead}</p>
      </div>
    </div>
  </section>

  <section class="px-6 md:px-12 lg:px-16 pb-16 md:pb-24 border-b border-white/[0.06]" aria-labelledby="cloud-heading">
    <div class="max-w-7xl mx-auto">
      <h2 id="cloud-heading" class="sr-only">The words that show up most</h2>
      <div class="cloud border border-white/[0.08] px-6 py-8 md:px-10 md:py-12">
        {cloud.map((t) => (
          <span class={`cloud-term heading-display ${t.tone} ${t.weight}`} style={`--s: ${t.rem}rem`}>{t.label}</span>
        ))}
      </div>
      <p class="mt-4 font-mono text-[10px] tracking-[0.15em] uppercase text-surface-500">
        Sized by how often each word appears in the list below
      </p>
    </div>
  </section>

  <section class="px-6 md:px-12 lg:px-16 py-16 md:py-24 border-b border-white/[0.06]">
    <div class="max-w-7xl mx-auto">
      <div class="max-w-3xl">
        {runs.map((run, i) => (
          <section id={run.id} class={i === 0 ? "" : "mt-10 pt-8 border-t border-white/[0.06]"} aria-labelledby={`${run.id}-heading`}>
            <h2 id={`${run.id}-heading`} class="font-mono text-[10px] tracking-[0.15em] text-gold-500 mb-5">{run.project}</h2>
            <ul class="space-y-6">
              {run.items.map((b) => (
                <li class="flex items-start gap-4">
                  <span class="w-1.5 h-1.5 bg-gold-500 flex-shrink-0 mt-[0.65rem]" aria-hidden="true"></span>
                  <div>
                    <p class="text-surface-200 leading-relaxed">{b.text}</p>
                    <ul class="mt-3 flex flex-wrap gap-1.5">
                      {b.tools.map((tool) => (
                        <li class="border border-white/[0.08] px-2 py-1 font-mono text-[10px] tracking-[0.05em] text-surface-400">{tool}</li>
                      ))}
                    </ul>
                  </div>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </div>
  </section>

  <section class="px-6 md:px-12 lg:px-16 py-16 md:py-20">
    <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-6">
      <p class="text-surface-400">Working on something like these?</p>
      <div class="flex flex-wrap gap-x-8 gap-y-3">
        <a href="/#contact" class="group inline-flex items-center gap-2 text-sm text-white font-medium hover:text-gold-500 transition-colors">
          <span>Email me</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-1" aria-hidden="true"><path d="M5 12h14m-7-7l7 7-7 7" /></svg>
        </a>
        <a href="/" class="text-sm text-surface-300 hover:text-gold-500 transition-colors">Back to the homepage</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .cloud {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    column-gap: 0.6em;
    row-gap: 0.35em;
    line-height: 1.05;
  }
  .cloud-term {
    /* --s is the computed desktop size; phones cap it so "data" cannot fill a row alone */
    font-size: min(var(--s), 11vw);
    white-space: nowrap;
    letter-spacing: -0.02em;
  }
</style>
