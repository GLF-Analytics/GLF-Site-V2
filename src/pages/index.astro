---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Capabilities from "../components/Capabilities.astro";
import LiveStats from "../components/LiveStats.astro";
import SelectedWork from "../components/SelectedWork.astro";
import About from "../components/About.astro";
import SubstackCTA from "../components/SubstackCTA.astro";
import WorkingTogether from "../components/WorkingTogether.astro";
import { defaultTitle, defaultDescription } from "../config/site";
---
<BaseLayout title={defaultTitle} description={defaultDescription}>
  <Hero />
  <Capabilities />
  <LiveStats />
  <SelectedWork />
  <About />
  <SubstackCTA />
  <WorkingTogether />
</BaseLayout>
