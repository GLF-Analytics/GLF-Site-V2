---
/*
  /404 (S19, 9/15/26): the not-found page. Vercel serves this file for any path
  that does not exist, so a prospect with a bad link sees the site and two ways
  on, not the platform default. Prerendered like every other page.
*/
import BaseLayout from "../layouts/BaseLayout.astro";
import { orgInfo } from "../config/site";
export const prerender = true;
---
<BaseLayout title="Page not found" description="That page is not here. The homepage and an email address are." noindex>
  <section class="min-h-[70vh] flex items-center px-6 md:px-12 lg:px-16 pt-28 pb-20 md:pt-36 md:pb-28 border-b border-white/[0.06]">
    <div class="w-full max-w-7xl mx-auto">
      <span class="label block mb-4">Not found</span>
      <h1 class="heading-display text-4xl md:text-5xl text-white">That page is not here</h1>
      <p class="mt-6 text-surface-400 text-base md:text-lg leading-relaxed max-w-xl">
        The link may be old or the address may have a typo. Everything I do is on the homepage, and I read every email.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 mt-10">
        <a href="/" class="btn-primary group">
          <span>Go to the homepage</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="relative z-10 transition-transform group-hover:translate-x-1" aria-hidden="true"><path d="M5 12h14m-7-7l7 7-7 7" /></svg>
        </a>
        <a href={`mailto:${orgInfo.email}`} class="btn-secondary">
          <span>Email me</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
