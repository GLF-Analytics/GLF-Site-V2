---
/*
  /design-your-data-warehouse: the tool planner, and since S23 (9/15/26) GLF's
  lead generator. Indexable, linked from Gabriel's posts. Voice on this page =
  GLF Analytics "we" (his call 9/15; POSITIONING records the exception).

  The visitor's path (S25, 9/15/26, Gabriel's read: quick, easy, simpler):
  1. The first question is in the hero, beside the title (no example card, no
     independence paragraph). Ten screens of one question in a bordered card
     that holds one measured height (S17). No sign-up.
  2. The wait: while the AI reads, one slide every six seconds (four slides)
     says what is being assembled; when the picks land, one sentence about GLF
     Analytics for 2.5 s, then the result. The layer-by-layer preview of S23 is
     gone: the result is the reveal. Skip is on screen once the picks are in
     hand. The rules path (AI off) is instant, as before.
  3. The result: one dashboard. The total, one paragraph (the AI summary or
     the who-runs-it line), eight tiles where the tool name is the swap (a
     transparent select over the tile), one note line, three actions (download
     the card, copy link, edit answers), the text links (Markdown, CLAUDE.md,
     open in Claude, start over), the sources in a closed disclosure. The card
     is download only (src/lib/warehouseCard.ts, simplified). The finance read,
     tradeoffs and reasons still travel in the Markdown, the CLAUDE.md and the
     report email; they are off the page.
  4. Ten seconds after the result, once a session: the offer, a small fixed
     card asking for an email in exchange for the report. It posts to
     /api/warehouse-report and falls back to a mailto when that route is off.
  5. Under the tool: how a stack like this runs (three lines), who we are, three FAQ.

  Copy: src/data/warehouse-survey.ts. Prices: src/data/warehouse-catalog.ts.
  Engine: src/lib/warehouseCalc.ts (isomorphic). Card: src/lib/warehouseCard.ts.
  Email: src/lib/warehouseReport.ts + src/pages/api/warehouse-report.ts.
  Build guards below: sources and dates on every price, three or more tools per
  layer, no comma in a heading, no dash or exclamation point in the copy, the
  three reference scenarios priced by the engine must equal the hand totals,
  the report email for those scenarios carries no dash and no dollar figure
  inside the GLF block, and the page copy stays under the word cap (S25).
*/
import BaseLayout from "../layouts/BaseLayout.astro";
import { catalog, LAYERS, scenarios, type Layer } from "../data/warehouse-catalog";
import { meta, questions, ui, result, layerCopy, sequence, offer, learn, who, faq } from "../data/warehouse-survey";
import { NOTES_MAX, priceStack, recommendByRules } from "../lib/warehouseCalc";
import { buildReport } from "../lib/warehouseReport";
import { orgInfo, siteUrl } from "../config/site";

// ---------- build guards ----------
for (const t of catalog) {
  if (!/^https:\/\//.test(t.source)) throw new Error(`[warehouse] ${t.id}: source must be an https URL`);
  if (!/^\d{4}-\d{2}-\d{2}$/.test(t.checked)) throw new Error(`[warehouse] ${t.id}: checked must be YYYY-MM-DD`);
  if (!t.why.trim() || !t.tradeoff.trim()) throw new Error(`[warehouse] ${t.id}: why and tradeoff are required`);
}
for (const layer of LAYERS) {
  const n = catalog.filter((t) => t.layer === layer).length;
  if (n < 3) throw new Error(`[warehouse] layer ${layer} has ${n} tools; at least 3`);
}
const titles = [
  meta.title,
  result.heading,
  result.sourcesHeading,
  ...sequence.slides.map((sl) => sl.title),
  sequence.closing.title,
  offer.label,
  learn.heading,
  who.heading,
  ...faq.map((f) => f.q),
  ...questions.map((q) => q.title),
  ...Object.values(layerCopy).map((l) => l.name)
];
for (const t of titles) if (t.includes(",")) throw new Error(`[warehouse] comma in a title: "${t}"`);
const copyText = JSON.stringify({ meta, questions, ui, result, layerCopy, sequence, offer, learn, who, faq, catalog: catalog.map((t) => [t.why, t.tradeoff, t.name, t.tier]) });
if (/[–—]/.test(copyText)) throw new Error("[warehouse] em or en dash in the copy or catalog");
if (/!/.test(JSON.stringify({ meta, ui, result, sequence, offer, learn, who, faq }))) throw new Error("[warehouse] exclamation point in the page copy");
// S25: the page copy word count (every string in the objects the page renders; functions are not counted). The cap keeps the cut.
const words = (v: unknown): number =>
  typeof v === "string" ? v.trim().split(/\s+/).filter(Boolean).length : Array.isArray(v) ? v.reduce((n: number, x) => n + words(x), 0) : v && typeof v === "object" ? Object.values(v).reduce((n: number, x) => n + words(x), 0) : 0;
const pageWords = words({ meta: [meta.eyebrow, meta.title, meta.lede, meta.promise], questions, ui, sequence, result, offer, learn, who, faq });
const WORD_CAP = 1100;
if (pageWords > WORD_CAP) throw new Error(`[warehouse] ${pageWords} words of page copy, cap ${WORD_CAP}`);

const names = Object.fromEntries(LAYERS.map((l) => [l, layerCopy[l].name])) as Record<Layer, string>;
const pageUrl = `${siteUrl}/${meta.slug}`;

const scenarioTotals = scenarios.map((s) => {
  const stack = priceStack(recommendByRules(s.answers), s.answers);
  if (Math.round(stack.low) !== s.low || Math.round(stack.high) !== s.high) {
    const detail = stack.lines.map((l) => `${l.layer}=${l.tool?.id ?? "none"} ${l.price.low}-${l.price.high}`).join(", ");
    throw new Error(`[warehouse] scenario "${s.name}" priced ${stack.low}-${stack.high}, expected ${s.low}-${s.high} (${detail})`);
  }
  // The report email for this scenario: no dash, no exclamation point, and no dollar figure inside the GLF block.
  const report = buildReport({ answers: s.answers, stack, reasons: {}, summary: "", mentioned: [], answersUrl: pageUrl, postal: "Los Angeles, CA", replyTo: orgInfo.email, sentOn: "2026-09-15" });
  if (/[–—!]/.test(report.text) || /[–—!]/.test(report.html.replace(/<!doctype html>/i, ""))) throw new Error(`[warehouse] dash or exclamation point in the report for "${s.name}"`);
  const glf = report.text.split("HOW GLF ANALYTICS WOULD BUILD AND RUN IT")[1]?.split("Edit the answers")[0] ?? "";
  if (/\$/.test(glf)) throw new Error(`[warehouse] a dollar figure inside the GLF block for "${s.name}"`);
  return `${s.name} $${s.low}-$${s.high}`;
});
const priced = catalog.filter((t) => t.price.kind !== "notPublished").length;
const oldest = catalog.map((t) => t.checked).sort()[0];
console.log(
  `[warehouse] ${catalog.length} tools, ${priced} priced, ${catalog.length - priced} not published, oldest check ${oldest}, scenarios ${scenarioTotals.join(" / ")}, ${questions.length} questions, ${sequence.slides.length} slides, ${faq.length} faq, ${pageWords} words of page copy (cap ${WORD_CAP})`
);

const total = questions.length;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": `${pageUrl}#app`,
      name: meta.title,
      url: pageUrl,
      description: meta.description,
      applicationCategory: "BusinessApplication",
      operatingSystem: "Any",
      isAccessibleForFree: true,
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
      provider: { "@id": `${siteUrl}/#organization` }
    },
    {
      "@type": "FAQPage",
      "@id": `${pageUrl}#faq`,
      mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } }))
    }
  ]
};
---
<BaseLayout title={meta.title} description={meta.description} ogImage={`${siteUrl}/images/og-warehouse.png`}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="wh" data-email={orgInfo.email} data-url={pageUrl}>
    <section class="pt-24 pb-12 md:pt-28 md:pb-16 px-6 md:px-12 lg:px-16">
      <div class="max-w-7xl mx-auto grid lg:grid-cols-12 gap-10 lg:gap-12 items-start">
        <div class="lg:col-span-5 lg:pt-4">
          <span class="label block mb-4">{meta.eyebrow}</span>
          <h1 class="heading-display text-4xl md:text-5xl text-white">{meta.title}</h1>
          <p class="mt-6 text-surface-300 text-lg leading-relaxed max-w-xl">{meta.lede}</p>
          <p class="mt-4 text-white text-base">{meta.promise}</p>
        </div>

        <div class="lg:col-span-7">
          <noscript><p class="mb-6 text-sm text-surface-400">{ui.noScript}</p></noscript>
          <div class="wh-card" data-card>
            <form class="wh-form" novalidate>
              <div class="wh-progress">
                <p class="wh-progress__label" data-progress aria-live="polite">{ui.questionOf(1, total)}</p>
                <div class="wh-progress__track" aria-hidden="true"><div class="wh-progress__fill" data-fill></div></div>
              </div>

              <div class="wh-stage" data-stage>
                {questions.map((q, i) => (
                  <fieldset class="wh-step" data-step={i} data-type={q.type} hidden={i !== 0}>
                    <legend class="sr-only">{ui.questionOf(i + 1, total)}</legend>
                    <div class="wh-step__inner">
                      {q.type === "notes" ? (
                        <div class="wh-q">
                          <h2 class="wh-q__title" tabindex="-1"><label for="wh-notes">{q.title}</label></h2>
                          <p class="wh-q__hint" id="wh-notes-hint">{q.hint}</p>
                          <textarea id="wh-notes" name="notes" rows="5" maxlength={NOTES_MAX} class="wh-notes" placeholder={q.placeholder} aria-describedby="wh-notes-hint wh-notes-count"></textarea>
                          <p class="wh-q__count" id="wh-notes-count" data-count>0 / {NOTES_MAX}</p>
                        </div>
                      ) : (
                        <div class="wh-q" role={q.type === "single" ? "radiogroup" : "group"} aria-labelledby={`q-${q.key}`}>
                          <h2 id={`q-${q.key}`} class="wh-q__title" tabindex="-1">{q.title}</h2>
                          {q.hint && <p class="wh-q__hint">{q.hint}</p>}
                          <div class={q.type === "single" ? "wh-choices" : "wh-chips"}>
                            {q.choices.map((c) => (
                              <label class={q.type === "single" ? "wh-choice" : "wh-choice wh-choice--chip"}>
                                <input type={q.type === "single" ? "radio" : "checkbox"} name={q.key} value={c.value} />
                                <span>{c.label}</span>
                              </label>
                            ))}
                          </div>
                        </div>
                      )}
                      <div class="wh-nav">
                        <p class="wh-nav__hint" id={`wh-hint-${i}`} data-next-hint data-off={q.type !== "single" ? "" : undefined}>{ui.pickToContinue}</p>
                        {i > 0 && <button type="button" class="btn-secondary" data-back>{ui.back}</button>}
                        {q.type === "notes" ? (
                          <button type="submit" class="btn-primary"><span>{ui.submit}</span></button>
                        ) : (
                          <button type="button" class="btn-primary" data-next disabled={q.type === "single"} aria-describedby={q.type === "single" ? `wh-hint-${i}` : undefined}><span>{ui.next}</span></button>
                        )}
                      </div>
                    </div>
                  </fieldset>
                ))}
              </div>
            </form>

            <div class="wh-loading" data-loading hidden aria-live="polite">
              <p class="wh-loading__label" data-seq-label></p>
              <p class="wh-loading__phrase" data-phrase>{ui.loading}</p>
              <p class="wh-loading__text" data-seq-text></p>
              <div class="wh-loading__track" aria-hidden="true"><div class="wh-loading__bar" data-bar></div></div>
              <p class="wh-loading__note" data-loading-note hidden>{ui.loadingNote}</p>
              <div class="wh-loading__foot">
                <p class="wh-loading__credit">{ui.credit}</p>
                <button type="button" class="wh-loading__skip" data-skip hidden>{ui.skip}</button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="px-6 md:px-12 lg:px-16 pb-16 md:pb-24 border-b border-white/[0.06]">
      <div class="max-w-7xl mx-auto">
        <div class="max-w-4xl">
          <section class="wh-result" data-result hidden aria-labelledby="wh-heading">
            <div class="wh-summary">
              <h2 id="wh-heading" class="wh-eyebrow" tabindex="-1">{result.heading}</h2>
              <p class="wh-summary__total" aria-live="polite">
                <strong class="heading-display text-4xl md:text-5xl text-white" data-total></strong>
                <span class="wh-summary__per">{result.perMonth}</span>
              </p>
              <p class="wh-summary__budget" data-budget hidden></p>
              <p class="wh-summary__small" data-small hidden>{result.smallStack}</p>
              <p class="wh-summary__read" data-read></p>
              <ul class="wh-summary__mentioned" data-mentioned hidden></ul>
              <ol class="wh-tiles" data-tiles></ol>
              <p class="wh-summary__hint">{result.swapHint}</p>
              <p class="wh-summary__meta" data-note></p>
            </div>

            <div class="wh-actions mt-8">
              <button type="button" class="btn-primary" data-download-card><span>{result.downloadCard}</span></button>
              <button type="button" class="btn-secondary" data-copy="link">{result.utilities.copyLink}</button>
              <button type="button" class="btn-secondary" data-edit>{ui.edit}</button>
            </div>
            <ul class="wh-links">
              <li><button type="button" data-copy="md">{result.utilities.copyMd}</button></li>
              <li><button type="button" data-copy="claude">{result.utilities.copyClaude}</button></li>
              <li><a data-open-claude href="https://claude.ai/new" target="_blank" rel="noopener">{result.utilities.openClaude}</a></li>
              <li><button type="button" data-restart>{ui.restart}</button></li>
            </ul>

            <details class="wh-details">
              <summary>{result.sourcesHeading}</summary>
              <ul class="wh-sources" data-sources></ul>
            </details>
            <p class="mt-6 text-sm"><a href="#" class="wh-report-link" data-offer-open>{result.reportLink}</a></p>
          </section>

          <template id="wh-tile">
            <li class="wh-tile">
              <span class="wh-tile__layer" data-layer></span>
              <p class="wh-tile__tool" data-tool></p>
              <p class="wh-tile__cost" data-cost></p>
              <p class="wh-tile__warn" data-warn hidden></p>
              <select class="wh-tile__select" data-swap></select>
            </li>
          </template>

        <div class="wh-offer" data-offer hidden role="region" aria-labelledby="wh-offer-label">
          <form class="wh-offer__form" data-offer-form novalidate>
            <div class="wh-offer__head">
              <p class="wh-offer__label" id="wh-offer-label">{offer.label}</p>
              <button type="button" class="wh-offer__x" data-offer-dismiss aria-label={offer.dismiss}>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
              </button>
            </div>
            <p class="wh-offer__line">{offer.line}</p>
            <div class="wh-offer__row">
              <label class="sr-only" for="wh-offer-email">{offer.emailLabel}</label>
              <input id="wh-offer-email" class="wh-offer__input" type="email" name="email" inputmode="email" autocomplete="email" placeholder={offer.placeholder} required />
              <input class="wh-offer__hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
              <button type="submit" class="btn-primary" data-offer-send><span>{offer.send}</span></button>
            </div>
            <label class="wh-offer__opt"><input type="checkbox" name="notes" /><span>{offer.optIn}</span></label>
            <p class="wh-offer__consent">{offer.consent}</p>
            <p class="wh-offer__status" data-offer-status aria-live="polite" hidden></p>
            <button type="button" class="wh-offer__no" data-offer-dismiss>{offer.dismiss}</button>
          </form>
          <div class="wh-offer__done" data-offer-done hidden>
            <div class="wh-offer__head">
              <p class="wh-offer__label">{offer.label}</p>
              <button type="button" class="wh-offer__x" data-offer-dismiss aria-label={offer.close}>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
              </button>
            </div>
            <p class="wh-offer__line" data-offer-done-text aria-live="polite"></p>
            <div data-offer-purpose>
              <p class="wh-offer__q">{offer.purposeQuestion}</p>
              <div class="wh-offer__chips">
                {offer.purposes.map((p) => <button type="button" class="wh-offer__chip" data-purpose={p.value}>{p.label}</button>)}
              </div>
            </div>
            <p class="wh-offer__thanks" data-offer-thanks hidden>{offer.purposeThanks}</p>
            <p class="wh-offer__fallback" data-offer-fallback hidden><a data-offer-mailto href={`mailto:${orgInfo.email}`}>{result.emailLabel}</a></p>
          </div>
        </div>
      </div>
    </div>
  </section>
  </div>

  <section class="px-6 md:px-12 lg:px-16 py-16 md:py-24 border-b border-white/[0.06]">
    <div class="max-w-7xl mx-auto grid lg:grid-cols-12 gap-10 lg:gap-8">
      <div class="lg:col-span-7 max-w-2xl">
        <h2 class="wh-sub mt-0" id="how-it-runs">{learn.heading}</h2>
        <ul class="wh-learn">
          {learn.lines.map((l) => <li>{l}</li>)}
        </ul>
      </div>
      <div class="lg:col-span-5">
        <h2 class="wh-sub mt-0" id="who">{who.heading}</h2>
        <div class="mt-4 flex items-start gap-4">
          <img src="/images/gabriel-freeman.webp" alt="Gabriel Freeman" width="427" height="427" loading="lazy" decoding="async" class="w-14 h-14 md:w-16 md:h-16 rounded-full border border-white/[0.08] flex-shrink-0" />
          <p class="text-surface-300 leading-relaxed">{who.text}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="px-6 md:px-12 lg:px-16 py-16 md:py-24 border-b border-white/[0.06]">
    <div class="max-w-7xl mx-auto">
      <div class="max-w-2xl">
        <h2 class="wh-sub mt-0" id="faq">Questions</h2>
        <dl class="wh-faq">
          {faq.map((f) => (
            <div>
              <dt>{f.q}</dt>
              <dd>{f.a}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <section class="px-6 md:px-12 lg:px-16 py-16 md:py-20">
    <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-6">
      <p class="text-surface-400">{result.closing}</p>
      <div class="flex flex-wrap gap-x-8 gap-y-3">
        <a href={`mailto:${orgInfo.email}?subject=${encodeURIComponent("Building a data warehouse")}`} class="group inline-flex items-center gap-2 text-sm text-white font-medium hover:text-gold-500 transition-colors">
          <span>Email us</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-1" aria-hidden="true"><path d="M5 12h14m-7-7l7 7-7 7" /></svg>
        </a>
        <a href="/" class="text-sm text-surface-300 hover:text-gold-500 transition-colors">Back to the homepage</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { LAYERS, type Layer } from "../data/warehouse-catalog";
  import { questions, ui, result, layerCopy, sequence, offer } from "../data/warehouse-survey";
  import { stackCardSvg } from "../lib/warehouseCard";
  type Mentioned = { name: string; id: string | null };
  import {
    alternatives,
    budgetFit,
    byId,
    deltaText,
    fromQuery,
    moneyRange,
    parseAnswers,
    priceStack,
    recommendByRules,
    smallStack,
    stackToClaudeMd,
    stackToMarkdown,
    toQuery,
    type Answers,
    type Picks
  } from "../lib/warehouseCalc";

  // Vercel Web Analytics custom events: a no-op until the script is served (see BaseLayout).
  const track = (name: string, data?: Record<string, string | number | boolean>) => {
    try {
      (window as unknown as { va?: (k: string, p: unknown) => void }).va?.("event", { name, data });
    } catch {}
  };

  const root = document.querySelector<HTMLElement>(".wh");
  const form = root?.querySelector<HTMLFormElement>(".wh-form");
  if (root && form) {
    const card = root.querySelector<HTMLElement>("[data-card]")!;
    const stage = form.querySelector<HTMLElement>("[data-stage]")!;
    const stepsEls = [...form.querySelectorAll<HTMLFieldSetElement>(".wh-step")];
    const progress = form.querySelector<HTMLElement>("[data-progress]")!;
    const fill = form.querySelector<HTMLElement>("[data-fill]")!;
    const loading = root.querySelector<HTMLElement>("[data-loading]")!;
    const seqLabel = root.querySelector<HTMLElement>("[data-seq-label]")!;
    const phrase = root.querySelector<HTMLElement>("[data-phrase]")!;
    const seqText = root.querySelector<HTMLElement>("[data-seq-text]")!;
    const bar = root.querySelector<HTMLElement>("[data-bar]")!;
    const loadingNote = root.querySelector<HTMLElement>("[data-loading-note]")!;
    const skip = root.querySelector<HTMLButtonElement>("[data-skip]")!;
    const resultEl = root.querySelector<HTMLElement>("[data-result]")!;
    const notes = form.querySelector<HTMLTextAreaElement>("#wh-notes")!;
    const count = form.querySelector<HTMLElement>("[data-count]")!;
    const template = root.querySelector<HTMLTemplateElement>("#wh-tile")!;
    const offerEl = root.querySelector<HTMLElement>("[data-offer]")!;
    const email = root.dataset.email ?? "";
    const pageUrl = root.dataset.url ?? `${location.origin}${location.pathname}`;
    const names = Object.fromEntries(LAYERS.map((l) => [l, layerCopy[l].name])) as Record<Layer, string>;
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const today = () => new Date().toISOString().slice(0, 10);
    let current = 0;

    // First-touch attribution, read before the submit rewrites the query string.
    const SRC_KEY = "wh-src";
    try {
      const q = new URLSearchParams(location.search);
      const parts = ["utm_source", "utm_medium", "utm_campaign", "ref"].map((k) => q.get(k)).filter(Boolean) as string[];
      const src = parts.length ? parts.join("/") : document.referrer ? new URL(document.referrer).hostname : "";
      if (src && !sessionStorage.getItem(SRC_KEY)) sessionStorage.setItem(SRC_KEY, src.slice(0, 100));
    } catch {}
    const ref = () => {
      try {
        return sessionStorage.getItem(SRC_KEY) ?? "";
      } catch {
        return "";
      }
    };

    type View = { answers: Answers; picks: Picks; reasons: Record<string, string>; summary: string; source: "ai" | "rules"; swapped: Layer[]; pending?: boolean; mentioned: Mentioned[] };
    let view: View | null = null;
    const makeView = (answers: Answers, picks: Picks, reasons: Record<string, string>, summary: string, source: "ai" | "rules", mentioned: Mentioned[] = []): View => ({ answers, picks, reasons, summary, source, swapped: [], mentioned });
    // The route already cleans these; the page still treats them as text and keeps only well-formed items.
    const readMentioned = (raw: unknown): Mentioned[] =>
      Array.isArray(raw)
        ? raw
            .filter((m) => m && typeof m.name === "string" && (m.id === null || typeof m.id === "string"))
            .map((m) => ({ name: String(m.name).slice(0, 40), id: typeof m.id === "string" && byId.has(m.id) ? m.id : null }))
            .slice(0, 5)
        : [];

    const checked = (name: string) => form.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`)?.value;

    function stepReady(i: number): boolean {
      const q = questions[i];
      return !q || q.type !== "single" || Boolean(checked(q.key));
    }

    // One card height for every question: the tallest one at this width.
    function measure() {
      if (card.hidden) return;
      stage.style.removeProperty("--wh-stage-h");
      let max = 0;
      for (const el of stepsEls) {
        const wasHidden = el.hidden;
        el.hidden = false;
        el.style.cssText = "position:absolute;left:0;right:0;top:0;visibility:hidden";
        max = Math.max(max, el.offsetHeight);
        el.style.cssText = "";
        el.hidden = wasHidden;
      }
      stage.style.setProperty("--wh-stage-h", `${Math.ceil(max)}px`);
    }

    // The page stays still: scroll only when the card's top has left the screen.
    function keepInView() {
      if (card.getBoundingClientRect().top < 64) card.scrollIntoView({ block: "start", behavior: "smooth" });
    }

    let startedOnce = false;
    function show(i: number, focus = true) {
      if (i > 0 && !startedOnce) {
        startedOnce = true;
        track("planner_start");
      }
      current = i;
      stepsEls.forEach((el, n) => (el.hidden = n !== i));
      progress.textContent = ui.questionOf(i + 1, stepsEls.length);
      fill.style.width = `${((i + 1) / stepsEls.length) * 100}%`;
      refreshNext();
      saveDraft();
      if (focus) {
        keepInView();
        stepsEls[i].querySelector<HTMLElement>(".wh-q__title")?.focus({ preventScroll: true });
      }
    }

    function refreshNext() {
      const step = stepsEls[current];
      const next = step?.querySelector<HTMLButtonElement>("[data-next]");
      if (next) next.disabled = !stepReady(current);
      const hint = step?.querySelector<HTMLElement>("[data-next-hint]");
      if (hint) hint.toggleAttribute("data-off", step.dataset.type !== "single" || stepReady(current));
    }

    function collect(): Answers | null {
      const raw: Record<string, unknown> = {
        kinds: [...form!.querySelectorAll<HTMLInputElement>('input[name="kinds"]:checked')].map((i) => i.value),
        notes: notes.value.slice(0, notes.maxLength)
      };
      for (const q of questions) if (q.type === "single") raw[q.key] = checked(q.key);
      return parseAnswers(raw);
    }

    function prefill(a: Answers) {
      for (const q of questions) {
        if (q.type !== "single") continue;
        const input = form!.querySelector<HTMLInputElement>(`input[name="${q.key}"][value="${a[q.key]}"]`);
        if (input) input.checked = true;
      }
      form!.querySelectorAll<HTMLInputElement>('input[name="kinds"]').forEach((i) => (i.checked = a.kinds.includes(i.value as never)));
    }

    // A refresh or the browser's Back button keeps the answers so far (this tab only).
    const DRAFT_KEY = "wh-draft";
    type Draft = { picks: Record<string, string>; kinds: string[]; notes: string; step: number };

    function saveDraft() {
      const draft: Draft = {
        picks: {},
        kinds: [...form!.querySelectorAll<HTMLInputElement>('input[name="kinds"]:checked')].map((i) => i.value),
        notes: notes.value,
        step: current
      };
      for (const q of questions) {
        const v = q.type === "single" ? checked(q.key) : undefined;
        if (v) draft.picks[q.key] = v;
      }
      try {
        sessionStorage.setItem(DRAFT_KEY, JSON.stringify(draft));
      } catch {}
    }

    function restoreDraft(): boolean {
      let draft: Partial<Draft> | null = null;
      try {
        draft = JSON.parse(sessionStorage.getItem(DRAFT_KEY) ?? "null");
      } catch {}
      if (!draft || typeof draft !== "object") return false;
      for (const q of questions) {
        if (q.type !== "single") continue;
        const v = draft.picks?.[q.key];
        if (typeof v !== "string" || !q.choices.some((c) => c.value === v)) continue;
        const input = form!.querySelector<HTMLInputElement>(`input[name="${q.key}"][value="${v}"]`);
        if (input) input.checked = true;
      }
      const kinds = Array.isArray(draft.kinds) ? draft.kinds : [];
      form!.querySelectorAll<HTMLInputElement>('input[name="kinds"]').forEach((i) => (i.checked = kinds.includes(i.value)));
      if (typeof draft.notes === "string") {
        notes.value = draft.notes.slice(0, notes.maxLength);
        count.textContent = `${notes.value.length} / ${notes.maxLength}`;
      }
      const step = Number.isInteger(draft.step) ? Math.min(Math.max(draft.step as number, 0), stepsEls.length - 1) : 0;
      show(step, false);
      return true;
    }

    form.addEventListener("change", () => {
      refreshNext();
      saveDraft();
    });
    notes.addEventListener("input", () => {
      count.textContent = `${notes.value.length} / ${notes.maxLength}`;
      saveDraft();
    });
    form.querySelectorAll("[data-next]").forEach((b) => b.addEventListener("click", () => stepReady(current) && show(current + 1)));
    form.querySelectorAll("[data-back]").forEach((b) => b.addEventListener("click", () => show(Math.max(0, current - 1))));

    form.addEventListener("keydown", (e) => {
      if (e.key === "Enter" && (e.target as HTMLElement).tagName === "INPUT") {
        e.preventDefault();
        if (current < stepsEls.length - 1 && stepReady(current)) show(current + 1);
      }
    });

    // ---------- the wait ----------

    const REVEAL_TARGET_MS = 30_000;
    const SLIDE_MS = 6_000;
    const CLOSING_MS = 2_500;
    let timers: number[] = [];
    const clearTimers = () => {
      for (const t of timers) {
        window.clearTimeout(t);
        window.clearInterval(t);
      }
      timers = [];
    };

    const setSeq = (label: string, title: string, text: string) => {
      seqLabel.textContent = label;
      phrase.textContent = title;
      seqText.textContent = text;
      if (!reducedMotion) {
        phrase.classList.remove("is-swap");
        seqText.classList.remove("is-swap");
        void phrase.offsetWidth;
        phrase.classList.add("is-swap");
        seqText.classList.add("is-swap");
      }
    };

    function costText(line: ReturnType<typeof priceStack>["lines"][number]): string {
      if (!line.tool) return "";
      if (line.price.notPublished) return "Price not published";
      return `${moneyRange(line.price.low, line.price.high)}${line.price.estimate ? " est." : ""}`;
    }

    function openLoading() {
      loading.style.minHeight = `${form.offsetHeight}px`;
      form.hidden = true;
      resultEl.hidden = true;
      loading.hidden = false;
      skip.hidden = true;
      bar.style.width = "0%";
    }

    function finish(next: View) {
      clearTimers();
      bar.style.width = "100%";
      loading.hidden = true;
      card.hidden = true;
      skip.hidden = true;
      view = next;
      render();
      resultEl.hidden = false;
      resultEl.scrollIntoView({ block: "start", behavior: "smooth" });
      resultEl.querySelector<HTMLElement>("h2")?.focus({ preventScroll: true });
      track("result_shown", { source: next.source });
      scheduleOffer();
    }

    /** The picks are in hand (S25): one sentence about GLF Analytics, then the result. Skip is on screen. */
    function closing(next: View) {
      skip.hidden = false;
      loadingNote.hidden = true;
      setSeq(sequence.closingLabel, sequence.closing.title, sequence.closing.text);
      timers.push(window.setTimeout(() => finish(next), CLOSING_MS));
    }

    async function run(answers: Answers) {
      openLoading();
      const started = Date.now();
      // One honest line first. The slides, the note, and the meter only start if the route
      // is still working after 400 ms (the rules path answers before that).
      setSeq("", ui.loading, "");
      loadingNote.hidden = true;
      let slideIdx = 0;
      timers.push(
        window.setTimeout(() => {
          loadingNote.hidden = false;
          setSeq(sequence.waitLabel, sequence.slides[0].title, sequence.slides[0].text);
          if (!reducedMotion) {
            timers.push(
              window.setInterval(() => {
                slideIdx = (slideIdx + 1) % sequence.slides.length;
                setSeq(sequence.waitLabel, sequence.slides[slideIdx].title, sequence.slides[slideIdx].text);
              }, SLIDE_MS)
            );
          }
          // The meter is time based against the 30 second target and never claims completion before the result.
          timers.push(
            window.setInterval(() => {
              const t = (Date.now() - started) / REVEAL_TARGET_MS;
              bar.style.width = `${Math.min(95, t * 100).toFixed(1)}%`;
            }, 200)
          );
        }, 400)
      );

      const next = await suggest(answers);
      clearTimers();
      if (next.source !== "ai" || reducedMotion) {
        finish(next);
        return;
      }
      const onSkip = () => {
        skip.removeEventListener("click", onSkip);
        track("reveal_skipped");
        finish(next);
      };
      skip.addEventListener("click", onSkip);
      bar.style.width = "98%";
      closing(next);
    }

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const answers = collect();
      if (!answers) {
        const firstMissing = stepsEls.findIndex((_, i) => !stepReady(i));
        show(firstMissing === -1 ? 0 : firstMissing);
        return;
      }
      history.replaceState(null, "", `${location.pathname}?${toQuery(answers)}`);
      track("planner_submit", { note: answers.notes.trim() ? 1 : 0 });
      void run(answers);
    });

    // The rules pick first; the route may upgrade it to an AI pick. Any failure keeps the rules pick.
    async function suggest(answers: Answers): Promise<View> {
      let next = makeView(answers, recommendByRules(answers), {}, "", "rules");
      try {
        const ctrl = new AbortController();
        const timer = window.setTimeout(() => ctrl.abort(), 45_000);
        const res = await fetch("/api/warehouse-suggest", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ answers }),
          signal: ctrl.signal
        });
        window.clearTimeout(timer);
        const data = await res.json();
        if (data && data.picks && (data.source === "ai" || data.source === "rules")) {
          next = makeView(answers, data.picks, data.reasons ?? {}, data.summary ?? "", data.source, readMentioned(data.mentioned));
        }
      } catch {
        // Offline, timed out, or the route is missing: the rules pick stands.
      }
      return next;
    }

    // ---------- the result ----------

    const exportOpts = (v: View, stackReasons = true) => ({
      names,
      url: `${pageUrl}?${toQuery(v.answers)}`,
      reasons: stackReasons ? v.reasons : undefined,
      summary: v.summary,
      date: today()
    });

    function mailtoHref(v: View): string {
      const stack = priceStack(v.picks, v.answers);
      const lines = stack.lines.map((l) => `${layerCopy[l.layer].name}: ${l.tool ? `${l.tool.name}${l.tool.tier ? ` (${l.tool.tier})` : ""}, ${costText(l)}` : "not needed"}`);
      const body = [
        "Please send me the report for this stack:",
        "",
        ...lines,
        "",
        `${result.totalLabel}: ${moneyRange(stack.low, stack.high)} a month`,
        "",
        `My answers: ${pageUrl}?${toQuery(v.answers)}`
      ].join("\n");
      return `mailto:${email}?subject=${encodeURIComponent(result.emailSubject)}&body=${encodeURIComponent(body)}`;
    }

    function render() {
      if (!view) return;
      const { answers, picks, summary, source, swapped, mentioned } = view;
      const stack = priceStack(picks, answers);

      // ---- the total and the one paragraph ----
      root!.querySelector<HTMLElement>("[data-total]")!.textContent = moneyRange(stack.low, stack.high);
      const fit = budgetFit(stack, answers);
      const budgetEl = root!.querySelector<HTMLElement>("[data-budget]")!;
      budgetEl.dataset.status = fit;
      budgetEl.textContent = fit === "unsure" ? "" : result.budget[fit];
      budgetEl.hidden = fit === "unsure";
      root!.querySelector<HTMLElement>("[data-small]")!.hidden = !smallStack(answers);
      root!.querySelector<HTMLElement>("[data-read]")!.textContent = summary || result.runs[answers.runner];

      const mentionedLines = mentioned.map((m) => {
        const tool = m.id ? byId.get(m.id) : undefined;
        if (!tool) return result.mentioned.missing(m.name);
        if (picks[tool.layer] === tool.id) return result.mentioned.kept(m.name);
        const pickedId = picks[tool.layer];
        const picked = pickedId ? byId.get(pickedId) : undefined;
        return picked ? result.mentioned.swappedOut(m.name, picked.name) : result.mentioned.missing(m.name);
      });
      const mentionedEl = root!.querySelector<HTMLUListElement>("[data-mentioned]")!;
      mentionedEl.replaceChildren(...mentionedLines.map((text) => { const li = document.createElement("li"); li.textContent = text; return li; }));
      mentionedEl.hidden = !mentionedLines.length;

      // ---- the tiles: one per layer, the tool name is the swap ----
      const tiles = root!.querySelector<HTMLOListElement>("[data-tiles]")!;
      tiles.replaceChildren();
      for (const line of stack.lines) {
        const node = template.content.firstElementChild!.cloneNode(true) as HTMLLIElement;
        const $ = (sel: string) => node.querySelector<HTMLElement>(sel)!;
        const copy = layerCopy[line.layer];
        const select = node.querySelector<HTMLSelectElement>("[data-swap]")!;
        $("[data-layer]").textContent = copy.short ?? copy.name;

        if (!line.tool) {
          node.classList.add("wh-tile--off");
          $("[data-tool]").textContent = result.notNeeded;
          $("[data-cost]").remove();
          $("[data-warn]").remove();
          select.remove();
          tiles.append(node);
          continue;
        }

        const t = line.tool;
        $("[data-tool]").textContent = t.name;
        $("[data-cost]").textContent = costText(line);
        if (!line.compatible && t.requires) {
          const warn = $("[data-warn]");
          warn.textContent = result.needsPick;
          warn.hidden = false;
        }

        select.dataset.layer = line.layer;
        select.setAttribute("aria-label", `${result.swapLabel} ${copy.name}: ${t.name}`);
        for (const alt of alternatives(line.layer, picks, answers)) {
          const opt = document.createElement("option");
          opt.value = alt.tool.id;
          const isCurrent = alt.tool.id === t.id;
          const cost = alt.price.notPublished ? "price not published" : isCurrent ? moneyRange(alt.price.low, alt.price.high) : deltaText(alt.deltaHigh);
          opt.textContent = `${alt.tool.name}${alt.tool.tier ? ` (${alt.tool.tier})` : ""}, ${cost}${alt.compatible ? "" : " (needs another pick)"}`;
          opt.selected = isCurrent;
          select.append(opt);
        }
        select.addEventListener("change", () => {
          if (!view) return;
          view.picks = { ...view.picks, [line.layer]: select.value };
          delete view.reasons[line.layer];
          if (!view.swapped.includes(line.layer)) view.swapped.push(line.layer);
          track("layer_swapped", { layer: line.layer });
          render();
          tiles.querySelector<HTMLSelectElement>(`[data-swap][data-layer="${line.layer}"]`)?.focus({ preventScroll: true });
        });
        tiles.append(node);
      }

      // ---- one note line ----
      const noteLine = view.pending ? result.notePending : source === "ai" ? result.noteAi : result.noteRules;
      const notes = [
        noteLine,
        swapped.length ? result.swapped(swapped.length) : "",
        stack.estimates ? result.estimateNote : "",
        stack.unpriced.length ? result.unpricedNote(stack.unpriced.join(" and ")) : ""
      ];
      root!.querySelector<HTMLElement>("[data-note]")!.textContent = notes.filter(Boolean).join(" ");

      // ---- the sources (closed by default) ----
      const sources = root!.querySelector<HTMLUListElement>("[data-sources]")!;
      sources.replaceChildren();
      for (const line of stack.lines) {
        if (!line.tool) continue;
        const li = document.createElement("li");
        const a = document.createElement("a");
        a.href = line.tool.source;
        a.target = "_blank";
        a.rel = "noreferrer";
        a.textContent = line.tool.name;
        li.append(a, document.createTextNode(` checked ${line.tool.checked}${line.tool.secondary ? " (secondary source)" : ""}`));
        sources.append(li);
      }

      // ---- the handoff ----
      const md = stackToMarkdown(stack, answers, exportOpts(view));
      const ask = `Here is a data warehouse stack a planner suggested for my business. Pressure test it: what would you change, what would you keep, and what would you ask me before deciding?\n\n${md}`;
      root!.querySelector<HTMLAnchorElement>("[data-open-claude]")!.href = `https://claude.ai/new?q=${encodeURIComponent(ask)}`;
      root!.querySelector<HTMLAnchorElement>("[data-offer-mailto]")!.href = mailtoHref(view);
    }

    // Copy buttons read the current view at click time, so a swap is always in the copy.
    for (const btn of root.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
      const label = btn.textContent ?? "";
      btn.addEventListener("click", async () => {
        if (!view) return;
        const stack = priceStack(view.picks, view.answers);
        const kind = btn.dataset.copy!;
        const text =
          kind === "link" ? `${pageUrl}?${toQuery(view.answers)}` : kind === "md" ? stackToMarkdown(stack, view.answers, exportOpts(view)) : stackToClaudeMd(stack, view.answers, exportOpts(view));
        try {
          await navigator.clipboard.writeText(text);
          btn.textContent = result.utilities.copied;
          track(kind === "link" ? "copied_link" : kind === "md" ? "copied_md" : "copied_claude_md");
          window.setTimeout(() => (btn.textContent = label), 2000);
        } catch {
          window.prompt(label, text);
        }
      });
    }
    root.querySelector("[data-open-claude]")?.addEventListener("click", () => track("opened_in_claude"));

    // The card as a PNG: the SVG is redrawn with system fonts (nothing external loads inside an image), then rasterized at 2x.
    root.querySelector<HTMLButtonElement>("[data-download-card]")?.addEventListener("click", () => {
      if (!view) return;
      const stack = priceStack(view.picks, view.answers);
      const svg = stackCardSvg(stack, { names, url: pageUrl, fontSans: "'Helvetica Neue', Helvetica, Arial, sans-serif", fontMono: "Menlo, Consolas, 'Courier New', monospace" });
      const blob = new Blob([svg], { type: "image/svg+xml;charset=utf-8" });
      const url = URL.createObjectURL(blob);
      const img = new Image();
      img.onload = () => {
        const canvas = document.createElement("canvas");
        canvas.width = 2400;
        canvas.height = 1260;
        const ctx = canvas.getContext("2d");
        if (!ctx) return;
        ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
        URL.revokeObjectURL(url);
        canvas.toBlob((png) => {
          if (!png) return;
          const a = document.createElement("a");
          a.href = URL.createObjectURL(png);
          a.download = "glf-stack-card.png";
          a.click();
          window.setTimeout(() => URL.revokeObjectURL(a.href), 5000);
          track("card_downloaded");
        }, "image/png");
      };
      img.onerror = () => URL.revokeObjectURL(url);
      img.src = url;
    });

    // ---------- the offer ----------

    const OFFER_SESSION = "wh-offer";
    const OFFER_QUIET = "wh-offer-quiet";
    const QUIET_MS = 30 * 24 * 60 * 60 * 1000;
    const offerForm = offerEl.querySelector<HTMLFormElement>("[data-offer-form]")!;
    const offerDone = offerEl.querySelector<HTMLElement>("[data-offer-done]")!;
    const offerStatus = offerEl.querySelector<HTMLElement>("[data-offer-status]")!;
    const offerInput = offerEl.querySelector<HTMLInputElement>("#wh-offer-email")!;
    const offerSend = offerEl.querySelector<HTMLButtonElement>("[data-offer-send]")!;
    let leadId: string | null = null;
    let offerShown = false;

    const quiet = (): boolean => {
      try {
        if (sessionStorage.getItem(OFFER_SESSION)) return true;
        const q = JSON.parse(localStorage.getItem(OFFER_QUIET) ?? "null") as { s?: string; t?: number } | null;
        if (q && q.s === "sent") return true;
        if (q && typeof q.t === "number" && Date.now() - q.t < QUIET_MS) return true;
      } catch {}
      return false;
    };
    const remember = (state: "shown" | "dismissed" | "sent") => {
      try {
        sessionStorage.setItem(OFFER_SESSION, state);
        if (state !== "shown") localStorage.setItem(OFFER_QUIET, JSON.stringify({ s: state, t: Date.now() }));
      } catch {}
    };

    function showOffer(how: "timer" | "link") {
      if (offerShown) return;
      offerShown = true;
      offerForm.hidden = false;
      offerDone.hidden = true;
      offerEl.hidden = false;
      window.requestAnimationFrame(() => offerEl.classList.add("is-in"));
      remember("shown");
      track("offer_shown", { how });
    }

    function hideOffer() {
      offerEl.classList.remove("is-in");
      window.setTimeout(() => (offerEl.hidden = true), reducedMotion ? 0 : 400);
      offerShown = false;
    }

    // Ten seconds after the result, once a session, and only when the tab is on screen.
    function scheduleOffer() {
      if (quiet() || offerShown) return;
      const fire = () => {
        if (document.visibilityState !== "visible") {
          const onVisible = () => {
            document.removeEventListener("visibilitychange", onVisible);
            window.setTimeout(() => !quiet() && showOffer("timer"), 1000);
          };
          document.addEventListener("visibilitychange", onVisible);
          return;
        }
        if (!quiet()) showOffer("timer");
      };
      window.setTimeout(fire, 10_000);
    }

    offerEl.querySelectorAll("[data-offer-dismiss]").forEach((b) =>
      b.addEventListener("click", () => {
        const wasDone = !offerDone.hidden;
        if (!wasDone) {
          remember("dismissed");
          track("offer_dismissed");
        }
        hideOffer();
      })
    );
    root.querySelector("[data-offer-open]")?.addEventListener("click", (e) => {
      e.preventDefault();
      offerShown = false;
      showOffer("link");
      offerInput.focus();
    });

    async function sendReport(): Promise<void> {
      if (!view) return;
      const address = offerInput.value.trim();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(address)) {
        offerStatus.textContent = offer.badEmail;
        offerStatus.hidden = false;
        offerInput.focus();
        return;
      }
      // An incompatible swap is dropped before posting so the emailed stack matches the screen.
      const rules = recommendByRules(view.answers);
      const stack = priceStack(view.picks, view.answers);
      const picks = { ...view.picks };
      for (const l of stack.lines) if (!l.compatible) picks[l.layer] = rules[l.layer];
      const body = {
        email: address,
        answers: view.answers,
        picks,
        reasons: view.reasons,
        summary: view.summary,
        mentioned: view.mentioned,
        source: view.source,
        swapped: view.swapped.length,
        notes: offerForm.querySelector<HTMLInputElement>('input[name="notes"]')!.checked,
        website: offerForm.querySelector<HTMLInputElement>('input[name="website"]')!.value,
        ref: ref(),
        page: location.pathname
      };
      offerSend.disabled = true;
      offerSend.querySelector("span")!.textContent = offer.sending;
      offerStatus.hidden = true;
      track("offer_submit");
      let outcome: "sent" | "duplicate" | "off" | "rate" | "failed" | "email" = "failed";
      try {
        const ctrl = new AbortController();
        const timer = window.setTimeout(() => ctrl.abort(), 15_000);
        const res = await fetch("/api/warehouse-report", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(body), signal: ctrl.signal });
        window.clearTimeout(timer);
        const data = (await res.json().catch(() => null)) as { ok?: boolean; reason?: string; duplicate?: boolean; id?: string | null } | null;
        if (res.ok && data?.ok) {
          outcome = data.duplicate ? "duplicate" : "sent";
          leadId = typeof data.id === "string" ? data.id : null;
        } else if (res.status === 503) outcome = "off";
        else if (res.status === 429) outcome = "rate";
        else if (res.status === 400 && data?.reason === "email") outcome = "email";
      } catch {}
      offerSend.disabled = false;
      offerSend.querySelector("span")!.textContent = offer.send;

      if (outcome === "email") {
        offerStatus.textContent = offer.badEmail;
        offerStatus.hidden = false;
        return;
      }
      if (outcome === "rate") {
        offerStatus.textContent = offer.rate;
        offerStatus.hidden = false;
        return;
      }
      const doneText = offerEl.querySelector<HTMLElement>("[data-offer-done-text]")!;
      const fallback = offerEl.querySelector<HTMLElement>("[data-offer-fallback]")!;
      const purpose = offerEl.querySelector<HTMLElement>("[data-offer-purpose]")!;
      offerForm.hidden = true;
      offerDone.hidden = false;
      if (outcome === "sent" || outcome === "duplicate") {
        doneText.textContent = outcome === "sent" ? offer.sent : offer.sentDuplicate;
        fallback.hidden = true;
        purpose.hidden = false;
        remember("sent");
        track("report_sent", { optIn: body.notes });
      } else {
        // The route is off (no keys yet) or the send failed: the visitor's mail app carries the stack instead.
        doneText.textContent = offer.failed;
        fallback.hidden = false;
        purpose.hidden = true;
        track("report_fallback", { outcome });
      }
    }

    offerForm.addEventListener("submit", (e) => {
      e.preventDefault();
      void sendReport();
    });

    offerEl.querySelectorAll<HTMLButtonElement>("[data-purpose]").forEach((b) =>
      b.addEventListener("click", async () => {
        const purpose = b.dataset.purpose!;
        offerEl.querySelector<HTMLElement>("[data-offer-purpose]")!.hidden = true;
        offerEl.querySelector<HTMLElement>("[data-offer-thanks]")!.hidden = false;
        track("lead_purpose", { purpose });
        if (!leadId) return;
        try {
          await fetch("/api/warehouse-report", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ action: "purpose", id: leadId, purpose }) });
        } catch {}
      })
    );

    // Edit answers: back to question 1 with every pick held.
    root.querySelector("[data-edit]")?.addEventListener("click", () => {
      view = null;
      resultEl.hidden = true;
      card.hidden = false;
      form.hidden = false;
      loading.style.minHeight = "";
      measure();
      show(0);
    });

    root.querySelector("[data-restart]")?.addEventListener("click", () => {
      view = null;
      form.reset();
      count.textContent = `0 / ${notes.maxLength}`;
      history.replaceState(null, "", location.pathname);
      resultEl.hidden = true;
      card.hidden = false;
      form.hidden = false;
      loading.style.minHeight = "";
      measure();
      show(0);
    });

    let lastWidth = window.innerWidth;
    window.addEventListener("resize", () => {
      if (window.innerWidth === lastWidth) return;
      lastWidth = window.innerWidth;
      measure();
    });
    measure();
    const fontsReady = document.fonts?.ready ?? Promise.resolve();
    fontsReady.then(measure);

    // A shared or emailed link opens on the stack itself; Edit answers reopens the questions with every pick held.
    const shared = fromQuery(location.search);
    const harness = import.meta.env.DEV ? new URLSearchParams(location.search).get("_state") : null;
    if (harness) {
      // Dev-only screenshot harness (stripped from production builds):
      // _state=q1..q10 | measure | loading (&_slide=n) | closing | result | offer | sent | card, with _swap=layer:id for a swapped result.
      // `card` paints the stack card at 1200x630 in the corner for the social image screenshot.
      const a = shared ?? parseAnswers({ readers: "6-15", size: "2-10", systems: "4-6", kinds: ["store", "ads"], runner: "ai", ecosystem: "neither", freshness: "daily", askAi: "few", budget: "100-500", notes: "" })!;
      prefill(a);
      if (/^q\d+$/.test(harness)) show(Number(harness.slice(1)) - 1, false);
      if (harness === "measure") {
        fontsReady.then(() => {
          measure();
          const rows = stepsEls.map((el, i) => {
            show(i, false);
            const c = card.getBoundingClientRect();
            const nav = el.querySelector<HTMLElement>(".wh-nav")!.getBoundingClientRect();
            return `q${i + 1} card top ${Math.round(c.top)} height ${Math.round(c.height)} nav top ${Math.round(nav.top)}`;
          });
          show(0, false);
          const pre = document.createElement("pre");
          pre.id = "wh-measure";
          pre.textContent = rows.join("\n");
          document.body.append(pre);
        });
      }
      if (harness === "loading") {
        openLoading();
        loadingNote.hidden = false;
        const s = Number(new URLSearchParams(location.search).get("_slide") ?? 1) - 1;
        setSeq(sequence.waitLabel, sequence.slides[s]?.title ?? sequence.slides[0].title, sequence.slides[s]?.text ?? sequence.slides[0].text);
        bar.style.width = "35%";
      }
      if (harness === "closing") {
        openLoading();
        bar.style.width = "98%";
        skip.hidden = false;
        setSeq(sequence.closingLabel, sequence.closing.title, sequence.closing.text);
      }
      if (harness === "card") {
        const stack = priceStack(recommendByRules(a), a);
        const box = document.createElement("div");
        box.id = "wh-card-render";
        box.style.cssText = "position:fixed;left:0;top:0;width:1200px;height:630px;z-index:99999;background:#050505";
        box.innerHTML = stackCardSvg(stack, { names, url: pageUrl, example: true });
        document.body.append(box);
      }
      if (harness === "result" || harness === "offer" || harness === "sent") {
        view = makeView(a, recommendByRules(a), {}, "", "rules");
        const swap = new URLSearchParams(location.search).get("_swap");
        if (swap) {
          const [layer, id] = swap.split(":");
          view.picks = { ...view.picks, [layer]: id };
        }
        card.hidden = true;
        render();
        resultEl.hidden = false;
        if (harness === "offer") showOffer("link");
        if (harness === "sent") {
          showOffer("link");
          offerForm.hidden = true;
          offerDone.hidden = false;
          offerEl.querySelector<HTMLElement>("[data-offer-done-text]")!.textContent = offer.sent;
        }
      }
    } else if (shared) {
      prefill(shared);
      view = makeView(shared, recommendByRules(shared), {}, "", "rules");
      view.pending = true;
      card.hidden = true;
      render();
      resultEl.hidden = false;
      track("result_shown", { source: "shared" });
      scheduleOffer();
      suggest(shared).then((next) => {
        if (!view || view.answers !== shared) return;
        if (next.source === "ai" && !view.swapped.length) view = next;
        else view.pending = false;
        render();
      });
    } else if (!restoreDraft()) {
      show(0, false);
    }
  }
</script>
