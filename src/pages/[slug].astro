---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { outboundRel, siteUrl } from "../config/site";
import lastmod from "../data/lastmod.json";
import published from "../data/published.json";
import { meta as plannerMeta } from "../data/warehouse-survey";

export async function getStaticPaths() {
  const entries = await getCollection("work");
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry }
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const desktopBg = entry.data.backgroundImage;
const tabletBg = entry.data.backgroundImageTablet || desktopBg;
const mobileBg = entry.data.backgroundImageMobile || tabletBg;

const backgroundStyle = desktopBg
  ? `--work-bg-desktop: url('${desktopBg}') top center / cover no-repeat; --work-bg-tablet: url('${tabletBg}') top center / cover no-repeat; --work-bg-mobile: url('${mobileBg}') top center / cover no-repeat;`
  : undefined;

// S36 (9/30/26): the search title and description (fall back to the h1 and the
// summary), and an Article node tied to the site-wide Person and Organization.
// dateModified = the sitemap's lastmod for this page (src/lib/pageDates.ts).
// S37 (10/1/26): datePublished = the day the markdown first entered git
// (src/data/published.json, same helper), and the page's own share image
// (public/images/og/<slug>.png, drawn by scripts/og-cards.mjs).
const pageUrl = `${siteUrl}/${entry.slug}`;
const metaTitle = entry.data.seoTitle ?? entry.data.title;
const metaDescription = entry.data.metaDescription ?? entry.data.summary;
const modified = (lastmod as Record<string, string>)[`/${entry.slug}`];
const firstPublished = (published as Record<string, string>)[`/${entry.slug}`];
const ogImage = `${siteUrl}/images/og/${entry.slug}.png`;

// S37: the "Related work" row. Keys are case-study slugs or one of these pages;
// labels are the titles those pages already carry, so no new copy lives here.
const RELATED_PAGES: Record<string, { href: string; label: string }> = {
  [plannerMeta.slug]: { href: `/${plannerMeta.slug}`, label: plannerMeta.title }
};
const allWork = await getCollection("work");
const related = (entry.data.related ?? []).map((key) => {
  if (RELATED_PAGES[key]) return RELATED_PAGES[key];
  const other = allWork.find((w) => w.slug === key);
  if (!other || other.slug === entry.slug) throw new Error(`[work] ${entry.slug}: related "${key}" is not another case study or a known page`);
  return { href: `/${other.slug}`, label: other.data.seoTitle ?? other.data.title };
});
const articleLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "@id": `${pageUrl}#article`,
  headline: metaTitle,
  description: metaDescription,
  url: pageUrl,
  mainEntityOfPage: pageUrl,
  image: desktopBg && !desktopBg.endsWith(".svg") ? `${siteUrl}${desktopBg}` : ogImage,
  author: { "@id": `${siteUrl}/#person` },
  publisher: { "@id": `${siteUrl}/#organization` },
  isPartOf: { "@id": `${siteUrl}/#website` },
  ...(firstPublished ? { datePublished: firstPublished } : {}),
  ...(modified ? { dateModified: modified } : {}),
  // S37: his own product is tied to him as its creator (the client studies name no outside entity here).
  ...(entry.data.clientType === "My own product" && entry.data.url
    ? { about: { "@type": "WebApplication", name: entry.data.title, url: entry.data.url, creator: { "@id": `${siteUrl}/#person` } } }
    : {}),
  keywords: entry.data.tags.join(", "),
  inLanguage: "en"
};
---
<BaseLayout
  title={metaTitle}
  description={metaDescription}
  ogType="article"
  ogImage={ogImage}
  ogImageAlt={`${metaTitle}, a GLF Analytics case study`}
  crumb={entry.data.title}
  parent={{ name: "All work", path: "/work" }}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />
  <article>
    <!-- Hero Section -->
    <div
      class={`relative pt-32 pb-20 md:pt-40 md:pb-28 px-6 md:px-12 lg:px-16 ${desktopBg ? 'work-detail-bg' : ''}`}
      style={backgroundStyle}
    >

      <div class="relative max-w-5xl mx-auto">
        <!-- Header Card -->
        <div class="border border-white/[0.08] bg-surface-950 p-8 md:p-12 reveal-card" data-reveal>

          <!-- Meta -->
          <div class="flex flex-wrap items-center gap-4 mb-6">
            <span class="font-mono text-[11px] tracking-[0.2em] uppercase text-gold-500">
              {entry.data.clientType}
            </span>
          </div>

          <!-- Title -->
          <h1 class="heading-display text-4xl md:text-5xl lg:text-6xl text-white mb-6">
            {entry.data.title}
          </h1>

          <!-- Summary -->
          <p class="text-lg text-surface-300 max-w-2xl leading-relaxed">
            {entry.data.summary}
          </p>
          {entry.data.tools && (
            <ul class="mt-6 flex flex-wrap gap-1.5">
              {entry.data.tools.map((tool) => (
                <li class="border border-white/[0.08] px-2 py-1 font-mono text-[11px] tracking-[0.05em] text-surface-300">{tool}</li>
              ))}
            </ul>
          )}
        </div>
      </div>
    </div>

    <!-- Main Content -->
    <div class="px-6 md:px-12 lg:px-16 py-16 md:py-24 border-b border-white/[0.06]">
      <div class="max-w-5xl mx-auto">
        <!-- Challenge & Solution Grid -->
        <div class="grid md:grid-cols-2 gap-px bg-white/[0.06] mb-16 stagger-children" data-reveal>
          <div class="bg-surface-950 p-8 md:p-10">
            <span class="label block mb-4">Challenge</span>
            <p class="text-surface-300 leading-relaxed">{entry.data.challenge}</p>
          </div>
          <div class="bg-surface-950 p-8 md:p-10">
            <span class="label block mb-4">Solution</span>
            <p class="text-surface-300 leading-relaxed">{entry.data.solution}</p>
          </div>
        </div>

        <!-- Outcomes -->
        <div class="mb-16 border border-white/[0.08] bg-surface-950/50 p-8 md:p-10 reveal-card" data-reveal>
          <span class="label block mb-6">Outcomes</span>
          {Array.isArray(entry.data.outcomes) ? (
            <ul class="grid md:grid-cols-2 gap-4">
              {entry.data.outcomes.map((outcome) => (
                <li class="flex items-start gap-3">
                  <span class="w-1.5 h-1.5 bg-gold-500 mt-2 flex-shrink-0"></span>
                  <span class="text-surface-300">{outcome}</span>
                </li>
              ))}
            </ul>
          ) : (
            <p class="text-surface-300">{entry.data.outcomes}</p>
          )}
        </div>

        <!-- Testimonial -->
        {entry.data.testimonial && (
          <div class="mb-16 border border-white/[0.08] bg-surface-950/50 p-8 md:p-10 relative reveal-card" data-reveal>
            <span class="label block mb-6">Testimonial</span>
            <blockquote>
              <p class="text-lg text-surface-200 leading-relaxed pl-4 border-l-2 border-gold-500/30">
                {entry.data.testimonial}
              </p>
              {entry.data.testimonialAuthor && (
                <footer class="mt-6 pl-4">
                  <span class="text-surface-400">{entry.data.testimonialAuthor}</span>
                </footer>
              )}
            </blockquote>
          </div>
        )}

        <!-- Additional Content from Markdown -->
        <div class="work-content work-sections stagger-children" data-reveal>
          <Content />
        </div>

        <!-- Project Link -->
        {entry.data.url && (
          <div class="mt-12 pt-8 border-t border-white/[0.06] reveal" data-reveal>
            <a
              href={entry.data.url}
              target="_blank"
              rel={outboundRel(entry.data.url)}
              class="btn-secondary inline-flex"
            >
              <span>Open the site</span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M15 3h6v6m-11 5L21 3m-3 10v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
              </svg>
            </a>
          </div>
        )}

        <!-- Related work (S37, 10/1/26): the other case studies of the same kind, and the planner on the data studies -->
        {related.length > 0 && (
          <nav aria-label="Related work" class="mt-12 pt-8 border-t border-white/[0.06] reveal" data-reveal>
            <span class="label block mb-3">Related work</span>
            <ul>
              {related.map((r) => (
                <li>
                  <a href={r.href} class="group inline-flex items-center gap-2 py-2.5 text-surface-300 hover:text-gold-500 transition-colors">
                    <span>{r.label}</span>
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0 transition-transform group-hover:translate-x-1" aria-hidden="true"><path d="M5 12h14m-7-7l7 7-7 7" /></svg>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )}
      </div>
    </div>

    <!-- Back to Home Navigation (S33, 9/28/26: the contact line first) -->
    <div class="px-6 md:px-12 lg:px-16 py-12 reveal" data-reveal>
      <div class="max-w-5xl mx-auto flex flex-wrap items-center justify-between gap-6">
        <p class="text-surface-400">
          Working on something like this?
          <a href="/contact" class="text-white font-medium hover:text-gold-500 transition-colors whitespace-nowrap">Tell me about it</a>
        </p>
        <a
          href="/"
          class="group inline-flex items-center gap-3 text-surface-400 hover:text-gold-500 transition-colors"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="transition-transform group-hover:-translate-x-1"
            aria-hidden="true"
          >
            <path d="M19 12H5m7-7-7 7 7 7" />
          </svg>
          <span class="font-mono text-[11px] tracking-[0.15em] uppercase">Back to home</span>
        </a>
      </div>
    </div>
  </article>
</BaseLayout>
