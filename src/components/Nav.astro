---
import { orgInfo } from "../config/site";
---
<nav class="fixed top-0 w-full z-50 nav-glass">
  <div class="max-w-7xl mx-auto px-5 md:px-12 lg:px-16 h-14 flex items-center justify-between gap-4">
    <a href="/" class="font-mono text-[11px] tracking-[0.25em] text-white uppercase whitespace-nowrap">
      <span class="hidden sm:inline">GLF Analytics</span>
      <span class="sm:hidden">GLF</span>
    </a>

    <div class="flex items-center gap-4 sm:gap-7 font-mono text-[11px] tracking-[0.1em] sm:tracking-[0.18em] uppercase whitespace-nowrap">
      <a href="/#services" class="text-surface-400 hover:text-white transition-colors">What I do</a>
      <a href="/#live" class="text-surface-400 hover:text-white transition-colors">
        <span class="hidden sm:inline">Live sample</span>
        <span class="sm:hidden">Sample</span>
      </a>
      <a href="/#selected-work" class="text-surface-400 hover:text-white transition-colors">
        <span class="hidden sm:inline">Case studies</span>
        <span class="sm:hidden">Work</span>
      </a>
      <a href={`mailto:${orgInfo.email}`} class="text-gold-500 hover:text-white transition-colors">Email</a>
    </div>
  </div>
</nav>
