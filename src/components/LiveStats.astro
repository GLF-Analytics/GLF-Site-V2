---
import { getBcStats } from "../lib/bcStats";
import { bcStatsSource } from "../config/site";

const s = await getBcStats();
const fmt = (n: number) => n.toLocaleString("en-US");
const longDate = (iso: string) =>
  new Date(`${iso}T12:00:00Z`).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" });

const numbers = [
  { value: s.cards_30d, label: "cards made", window: "last 30 days" },
  { value: s.cards_since_launch, label: "cards made", window: `since launch, ${bcStatsSource.launchMonth}` },
  { value: s.visitors_30d, label: "visitors", window: "last 30 days" },
  { value: s.search_visitors_30d, label: "visitors from search engines", window: "last 30 days" }
];
---
<section id="live" class="py-20 md:py-28 px-6 md:px-12 lg:px-16 border-b border-white/[0.06]">
  <div class="max-w-7xl mx-auto">
    <div class="grid lg:grid-cols-12 gap-8 mb-12 md:mb-16">
      <div class="lg:col-span-5" data-reveal>
        <span class="label block mb-4">Proof I ship: birthday-cards.ai</span>
        <h2 class="heading-display text-4xl md:text-5xl text-white">One product, real numbers.</h2>
      </div>
      <div class="lg:col-span-7 lg:pt-10" data-reveal>
        <p class="text-surface-400 text-base md:text-lg max-w-xl leading-relaxed">
          I recommend systems for a living, so I built one and run it. birthday-cards.ai has been live since {bcStatsSource.launchMonth}. These are its numbers, read from its analytics, no rounding up.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-px bg-white/[0.06]" data-reveal>
      {numbers.map((n) => (
        <div class="bg-surface-950 p-6 md:p-8">
          <span class="block heading-display text-4xl md:text-5xl lg:text-6xl text-white tabular-nums">{fmt(n.value)}</span>
          <span class="block mt-3 text-sm text-surface-300">{n.label}</span>
          <span class="block mt-1 font-mono text-[10px] tracking-[0.15em] uppercase text-surface-500">{n.window}</span>
        </div>
      ))}
    </div>

    <div class="mt-6 flex flex-col md:flex-row md:items-start md:justify-between gap-6" data-reveal>
      <p class="text-xs text-surface-500 leading-relaxed max-w-2xl">
        Refreshed {longDate(s.fetched_at)} from {bcStatsSource.label}. Search engines counted: Google, Bing, DuckDuckGo, Yahoo, Ecosia. Referrer counts are floors, since some browsers strip them. My own test sessions are in these totals.
      </p>
      <div class="flex flex-wrap gap-6 flex-shrink-0">
        <a href={bcStatsSource.productUrl} target="_blank" rel="noreferrer" class="group inline-flex items-center gap-2 text-sm text-white hover:text-gold-500 transition-colors">
          <span>Open birthday-cards.ai</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6m-11 5L21 3m-3 10v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" /></svg>
        </a>
        <a href="/birthday-cards" class="group inline-flex items-center gap-2 text-sm text-white hover:text-gold-500 transition-colors">
          <span>How I built it</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-1" aria-hidden="true"><path d="M5 12h14m-7-7l7 7-7 7" /></svg>
        </a>
      </div>
    </div>
  </div>
</section>
