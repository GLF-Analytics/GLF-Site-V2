---
import { getBcStats } from "../lib/bcStats";
import { bcStatsSource } from "../config/site";
import TypingDemo from "./TypingDemo.astro";

const s = await getBcStats();
const fmt = (n: number) => n.toLocaleString("en-US");
const longDate = (iso: string) =>
  new Date(`${iso}T12:00:00Z`).toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" });

const numbers = [
  { value: s.cards_30d, label: "cards made", window: "last 30 days" },
  { value: s.cards_since_launch, label: "cards made", window: `since ${bcStatsSource.launchMonth}` },
  { value: s.visitors_30d, label: "visitors", window: "last 30 days" },
  { value: s.search_visitors_30d, label: "visitors from search", window: "last 30 days" }
];

const built = [
  "Design",
  "Next.js front end",
  "OpenAI and Gemini image generation",
  "Email and PDF delivery",
  "Share and gift links",
  "Rate limits and spend caps",
  "Seven search landing pages",
  "Analytics, about 60 events"
];
---
<section id="live" class="py-20 md:py-28 px-6 md:px-12 lg:px-16 border-b border-white/[0.06]">
  <div class="max-w-7xl mx-auto grid lg:grid-cols-12 gap-12 lg:gap-10 items-center">
    <div class="lg:col-span-7 order-2 lg:order-1">
      <div data-reveal>
        <span class="label block mb-4">Something I built with AI</span>
        <h2 class="heading-display text-4xl md:text-5xl text-white">birthday-cards.ai</h2>
        <p class="mt-5 text-surface-400 text-base md:text-lg max-w-xl leading-relaxed">
          An AI card maker, live since {bcStatsSource.launchMonth}. Type a name or add a photo and get a printable card. The numbers are read from its analytics.
        </p>
      </div>

      <div class="mt-8" data-reveal>
        <span class="block font-mono text-[10px] tracking-[0.2em] uppercase text-surface-500 mb-3">Built end to end, with Claude Code</span>
        <ul class="flex flex-wrap gap-2">
          {built.map((item) => (
            <li class="border border-white/[0.08] px-3 py-1.5 text-xs text-surface-300">{item}</li>
          ))}
        </ul>
      </div>

      <div class="mt-8 grid grid-cols-2 md:grid-cols-4 gap-px bg-white/[0.06]" data-reveal>
        {numbers.map((n) => (
          <div class="bg-surface-950 p-5 md:p-6">
            <span class="block heading-display text-3xl md:text-4xl text-white tabular-nums">{fmt(n.value)}</span>
            <span class="block mt-2 text-sm text-surface-300">{n.label}</span>
            <span class="block mt-1 font-mono text-[10px] tracking-[0.15em] uppercase text-surface-500">{n.window}</span>
          </div>
        ))}
      </div>

      <div class="mt-6 flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-6" data-reveal>
        <a href={bcStatsSource.productUrl} target="_blank" rel="noreferrer" class="btn-primary group">
          <span>Make a card</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="relative z-10" aria-hidden="true"><path d="M15 3h6v6m-11 5L21 3m-3 10v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" /></svg>
        </a>
        <a href="/birthday-cards" class="group inline-flex items-center gap-2 text-sm text-white hover:text-gold-500 transition-colors">
          <span>How I built it</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-1" aria-hidden="true"><path d="M5 12h14m-7-7l7 7-7 7" /></svg>
        </a>
      </div>

      <p class="mt-5 text-xs text-surface-500 leading-relaxed max-w-xl" data-reveal>
        Refreshed {longDate(s.fetched_at)} from {bcStatsSource.label}.
      </p>
    </div>

    <div class="lg:col-span-5 order-1 lg:order-2" data-reveal>
      <TypingDemo />
    </div>
  </div>
</section>
