---
const areas = [
  {
    number: "01",
    title: "Data infrastructure and reporting",
    description:
      "BigQuery warehouses, the SQL that feeds them, GA4 and tagging done right, Looker Studio and Tableau reporting, and forecasting models the finance team can open and follow.",
    proof: "Unilever, UCAN",
    href: "/unilever"
  },
  {
    number: "02",
    title: "Growth strategy and marketing",
    description:
      "Paid media across Meta, TikTok, Google, and Amazon. Email and lifecycle in Klaviyo. SEO, loyalty, and the delivery channels and restaurant platforms behind them: Uber Eats, DoorDash, Olo, OneDine.",
    proof: "bartaco, Fox Fodder Flowers",
    href: "/bartaco"
  },
  {
    number: "03",
    title: "The tech that runs the business",
    description:
      "Shopify builds and theme work, app integrations, 3PL and inventory connections, CRM setup, conversion paths, stack audits that cut cost, and the broken-connection and bug work nobody wants to own.",
    proof: "Gotham Goods, bartaco",
    href: "/gotham-goods"
  },
  {
    number: "04",
    title: "AI tooling, inside the same stack",
    description:
      "Document automation on Power Automate and the Claude API for a team that lives in Microsoft tools, and AI products built end to end. My AI practice for construction teams lives at glf-ai.com.",
    proof: "A construction management company in LA, birthday-cards.ai",
    href: "/construction-ai-integration"
  }
];

const howItGoes = [
  "Exploration first: I map how the business runs and where the numbers break before proposing anything.",
  "A short ranked list, then a build that ships in weeks. The first win is usually a definition or a denominator, not a dashboard.",
  "One system, reused: the warehouse feeds the reporting, the reporting feeds the strategy, the same tools run the next project.",
  "You keep everything. The code, the reporting, the credentials, and a runbook your team can follow without me."
];
---
<section class="relative py-24 md:py-32 px-6 md:px-12 lg:px-16 border-b border-white/[0.06]" id="services">
  <div class="max-w-7xl mx-auto">
    <div class="grid lg:grid-cols-12 gap-8 mb-16 md:mb-20">
      <div class="lg:col-span-5">
        <div><div class="capabilities-heading-mask" data-reveal>
          <span class="label block mb-4">What I do</span>
        </div></div>
        <div><div class="capabilities-heading-mask" data-reveal>
          <h2 class="capabilities-heading heading-display text-4xl md:text-5xl lg:text-6xl text-white">
            Four kinds of work
          </h2>
        </div></div>
      </div>
      <div class="lg:col-span-7 lg:pt-12">
        <p class="capabilities-subtext text-surface-400 text-base md:text-lg max-w-xl leading-relaxed" data-reveal>
          All in service of one question: what should the business do next, and what do the numbers say.
        </p>
      </div>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-px bg-white/[0.06]">
      {areas.map((area, index) => (
        <a
          href={area.href}
          class="capability-card card card-accent bg-surface-950 p-8 md:p-10 group block"
          data-reveal
          style={`transition-delay: ${index * 100}ms`}
        >
          <div class="capability-content">
            <span class="block font-mono text-[10px] tracking-[0.2em] text-surface-600 mb-8">{area.number}</span>
            <h3 class="text-lg md:text-xl font-medium text-white mb-4 group-hover:text-gold-500 transition-colors">
              {area.title}
            </h3>
            <p class="text-sm text-surface-400 leading-relaxed mb-6">{area.description}</p>
            <p class="flex items-start gap-3 text-xs text-surface-500 leading-relaxed">
              <span class="w-1 h-1 bg-gold-500 flex-shrink-0 mt-1.5"></span>
              <span>{area.proof}</span>
            </p>
          </div>
        </a>
      ))}
    </div>

    <div class="mt-16 md:mt-20 grid lg:grid-cols-12 gap-8" data-reveal>
      <div class="lg:col-span-5">
        <span class="label block mb-4">How the work goes</span>
      </div>
      <ol class="lg:col-span-7 space-y-3">
        {howItGoes.map((line, i) => (
          <li class="flex items-start gap-4 text-sm md:text-base text-surface-300 leading-relaxed">
            <span class="font-mono text-[10px] tracking-[0.2em] text-surface-600 mt-1.5">0{i + 1}</span>
            <span>{line}</span>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
