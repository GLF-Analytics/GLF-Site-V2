---
const areas = [
  {
    number: "01",
    title: "Data infrastructure and reporting",
    line: "The numbers the business runs on.",
    skills: [
      "SQL warehouse setup",
      "Tagging, analytics + semantic layer",
      "Dashboard builds across visualization tools",
      "Forecasting models and strategic analysis",
      "Connect data to AI for natural language questions"
    ],
    names: "Unilever, UCAN",
    href: "/unilever",
    external: false
  },
  {
    number: "02",
    title: "Growth strategy and marketing execution",
    line: "Managing day-to-day marketing functions.",
    skills: [
      "Email marketing + audience segment management",
      "Uber Eats + DoorDash for restaurant groups",
      "SEO and Answer Engine Optimization (NEW)",
      "Paid media on Meta Ads, Google Ads, and Amazon"
    ],
    names: "bartaco, Fox Fodder Flowers",
    href: "/bartaco",
    external: false
  },
  {
    number: "03",
    title: "Managing tech and tools",
    line: "Supporting the backend systems.",
    skills: [
      "Set up or move to a new CRM",
      "Web development + conversion rate optimization",
      "DNS, domains, email deliverability"
    ],
    names: "Gotham Goods, bartaco",
    href: "/gotham-goods",
    external: false
  },
  {
    number: "04",
    title: "Integration of AI in organizations",
    line: "Strategic support on where AI fits and where it does not.",
    skills: [
      "Audit business workflows and plan AI tools",
      "Integrate AI systems, build custom tools",
      "Team training, prompt libraries",
      "AI-based analytics in natural language",
      "Human-in-the-loop philosophy, strict QA protocol"
    ],
    names: "A construction management company in LA, birthday-cards.ai",
    href: "https://glf-ai.com",
    external: true
  }
];

---
<section class="relative py-20 md:py-28 px-6 md:px-12 lg:px-16 border-b border-white/[0.06]" id="services">
  <div class="max-w-7xl mx-auto">
    <div class="mb-12 md:mb-16">
      <div><div class="capabilities-heading-mask" data-reveal>
        <span class="label block mb-4">What I do</span>
      </div></div>
      <div><div class="capabilities-heading-mask" data-reveal>
        <h2 class="capabilities-heading heading-display text-4xl md:text-5xl text-white">
          Four kinds of work
        </h2>
      </div></div>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-px bg-white/[0.06]">
      {areas.map((area, index) => (
        <a
          href={area.href}
          target={area.external ? "_blank" : undefined}
          rel={area.external ? "noreferrer" : undefined}
          class="capability-card card card-accent bg-surface-950 p-8 md:p-9 group block"
          data-reveal
          style={`transition-delay: ${index * 100}ms`}
        >
          <div class="capability-content flex flex-col h-full">
            <span class="block font-mono text-[11px] tracking-[0.2em] text-surface-500 mb-6">{area.number}</span>
            <h3 class="text-lg md:text-xl font-medium text-white mb-2 group-hover:text-gold-500 transition-colors">
              {area.title}
            </h3>
            <p class="text-sm text-surface-400 leading-relaxed mb-5">{area.line}</p>
            <ul class="space-y-2 mb-6">
              {area.skills.map((skill) => (
                <li class="flex items-start gap-3 text-[13px] text-surface-300 leading-snug">
                  <span class="w-1 h-1 bg-gold-500 flex-shrink-0 mt-[7px]"></span>
                  <span>{skill}</span>
                </li>
              ))}
            </ul>
            <p class="mt-auto text-xs text-surface-500 leading-relaxed">{area.names}</p>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>
