---
import {
  defaultTitle,
  defaultDescription,
  siteName,
  siteUrl,
  socialLinks
} from "../config/site";

// S37 (10/1/26): the default share image is public/images/og/default.png (drawn
// by scripts/og-cards.mjs in the site's type; the S2 og-default.png had a serif
// headline and a clipped line, and stays on disk). The alt says what the image
// shows: the default card carries the homepage title, a page's own card its title.
const defaultOgImage = `${siteUrl}/images/og/default.png`;
const {
  title = defaultTitle,
  description = defaultDescription,
  canonical,
  ogImage = defaultOgImage,
  ogImageAlt,
  ogType = "website",
  noindex = false
} = Astro.props;

// S36 (9/30/26): BaseLayout passes the canonical (no trailing slash, the same
// string the sitemap lists); the fallback strips the slash the same way.
const canonicalUrl = canonical ?? siteUrl + (Astro.url.pathname.replace(/\/+$/, "") || "/");
const pageTitle = title === defaultTitle ? title : `${title} | ${siteName}`;
const imageAlt = ogImageAlt ?? (ogImage === defaultOgImage ? defaultTitle.replace(" | ", ": ") : pageTitle);
---
<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />

{noindex ? <meta name="robots" content="noindex, nofollow" /> : null}

<meta property="og:type" content={ogType} />
<meta property="og:locale" content="en_US" />
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={ogImage} />
{/* Every social image is 1200x630; src/integrations/seoCheck.ts reads the PNG header and fails the build otherwise. */}
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
<meta name="twitter:image:alt" content={imageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
