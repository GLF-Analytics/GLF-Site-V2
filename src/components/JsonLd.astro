---
import { orgInfo, siteName, siteUrl, defaultDescription, socialLinks } from "../config/site";

const sameAs = Object.values(socialLinks).filter(Boolean);

// S36 (9/30/26): a raster logo (the safe format for rich results; the PNG is
// drawn by scripts/favicons.py from the same mark as the SVG), the headshot on
// the Person, and an @id on every node so page-level JSON-LD can point at them.
const logo = `${siteUrl}${orgInfo.logo}`;
const address = {
  "@type": "PostalAddress",
  addressLocality: orgInfo.address.city,
  addressRegion: orgInfo.address.region,
  addressCountry: orgInfo.address.country
};

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": `${siteUrl}/#organization`,
    name: orgInfo.name,
    legalName: orgInfo.legalName,
    url: siteUrl,
    logo,
    email: orgInfo.email,
    sameAs,
    founder: { "@id": `${siteUrl}/#person` },
    address
  },
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": `${siteUrl}/#person`,
    name: orgInfo.founder,
    jobTitle: "Founder, GLF Analytics",
    url: siteUrl,
    image: `${siteUrl}/images/gabriel-freeman.webp`,
    email: orgInfo.email,
    sameAs,
    worksFor: { "@id": `${siteUrl}/#organization` },
    knowsAbout: [
      "data infrastructure and reporting (BigQuery, SQL, Looker Studio)",
      "growth strategy and paid media",
      "eCommerce and digital systems (Shopify, CRMs, integrations)",
      "AI tooling and document automation"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": `${siteUrl}/#website`,
    name: siteName,
    url: siteUrl,
    description: defaultDescription,
    publisher: { "@id": `${siteUrl}/#organization` }
  },
  {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "@id": `${siteUrl}/#service`,
    name: siteName,
    url: siteUrl,
    image: logo,
    description: defaultDescription,
    address,
    founder: { "@id": `${siteUrl}/#person` },
    areaServed: "US",
    serviceType: [
      "data infrastructure and reporting",
      "growth strategy and paid media",
      "eCommerce and digital systems",
      "AI tooling"
    ]
  }
];
---
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
