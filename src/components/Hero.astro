---
import { orgInfo } from "../config/site";
---
<section class="min-h-[85vh] relative flex items-center border-b border-white/[0.06]">
  <div class="w-full max-w-7xl mx-auto px-6 md:px-12 lg:px-16 pt-28 pb-20 md:pt-36 md:pb-28">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-8 items-end">
      <div class="lg:col-span-8">
        <span class="hero-reveal label block mb-8">Gabriel Freeman, GLF Analytics, Los Angeles</span>

        <h1 class="hero-reveal hero-reveal--delay-1">
          <span class="block heading-display text-4xl sm:text-5xl md:text-6xl lg:text-[4rem] xl:text-[4.25rem] text-white">
            The data and the tech
          </span>
          <span class="block heading-display text-4xl sm:text-5xl md:text-6xl lg:text-[4rem] xl:text-[4.25rem] text-white mt-1">
            behind growing brands.
          </span>
        </h1>

        <p class="hero-reveal hero-reveal--delay-2 mt-8 md:mt-10 text-surface-400 text-base md:text-lg max-w-xl leading-relaxed font-light">
          I help brands grow with numbers and the right tools. Since 2017 I have set growth strategy and built the reporting behind it. I also audit the websites, apps, and AI a business runs on and build what is missing.
        </p>

        <div class="hero-reveal hero-reveal--delay-3 flex flex-col sm:flex-row gap-4 mt-10 md:mt-12">
          <a href={`mailto:${orgInfo.email}`} class="btn-primary group">
            <span>Email me</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="relative z-10 transition-transform group-hover:translate-x-1" aria-hidden="true"><path d="M5 12h14m-7-7l7 7-7 7" /></svg>
          </a>
          <a href="#selected-work" class="btn-secondary">
            <span>See the work</span>
          </a>
        </div>
      </div>

      <div class="lg:col-span-4 hero-reveal hero-reveal--delay-4">
        <div class="lg:pl-8 lg:border-l border-white/[0.06] grid grid-cols-2 lg:grid-cols-1 gap-8">
          <div>
            <span class="block font-mono text-[10px] tracking-[0.2em] uppercase text-gold-500 mb-2">Independent since</span>
            <span class="block heading-display text-3xl md:text-4xl text-white">2021</span>
          </div>
          <div>
            <span class="block font-mono text-[10px] tracking-[0.2em] uppercase text-gold-500 mb-2">Who I work with</span>
            <span class="block text-base md:text-lg text-white leading-snug">Brands, restaurant groups, startups, construction management firms, marketing agencies</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const heroItems = document.querySelectorAll(".hero-reveal");
  if (heroItems.length) {
    window.requestAnimationFrame(() => {
      heroItems.forEach((item) => item.classList.add("is-visible"));
    });
  }
</script>

<style is:global>
  .hero-reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 700ms cubic-bezier(0.16, 1, 0.3, 1), transform 700ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .hero-reveal.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
  .hero-reveal--delay-1 { transition-delay: 150ms; }
  .hero-reveal--delay-2 { transition-delay: 350ms; }
  .hero-reveal--delay-3 { transition-delay: 500ms; }
  .hero-reveal--delay-4 { transition-delay: 650ms; }

  @media (prefers-reduced-motion: reduce) {
    .hero-reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
