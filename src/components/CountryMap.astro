---
/**
 * The "Cards made in N countries" line under the birthday-cards.ai numbers,
 * and the dot-grid world map it reveals. Click opens it, the X in the panel
 * (or the line again, or Escape) closes it; nothing opens on hover (Gabriel,
 * 9/9/26: hover opened it by accident). The script below owns the state
 * through data-open, the CSS (global.css, COUNTRY MAP) only draws the transition.
 *
 * Data: src/data/world-dots.json (the grid, generated by scripts/world-dots.mjs)
 * and getBcCountries() (live Vercel analytics or src/data/bc-countries.json).
 * Every country with at least one card is gold, same dot size, equal weight.
 * A country too small for the grid gets one gold dot at its centroid.
 */
import { getBcCountries } from "../lib/bcStats";
import world from "../data/world-dots.json";

type Dot = [number, number, string];
type Place = { name: string; cx: number; cy: number };

const known = world.countries as Record<string, Place>;
const grid = world.dots as Dot[];
const data = await getBcCountries();

const codes = data.countries
  .map((c) => c.code)
  .filter((code) => {
    if (known[code]) return true;
    if (!data.live) {
      throw new Error(`[countryMap] ${code} in bc-countries.json is unknown to world-dots.json; fix the snapshot or rerun npm run map:dots`);
    }
    console.warn("[countryMap] unknown country code from live data, skipped:", code);
    return false;
  });
const gold = new Set(codes);

// One zero-length subpath per dot; round line caps turn each into a circle.
const dot = (x: number, y: number) => `M${x} ${y}h.01`;
const baseD = grid.filter((d) => !gold.has(d[2])).map((d) => dot(d[0], d[1])).join("");

let goldDots = 0;
let fallbacks = 0;
const groups = codes
  .map((code) => {
    const own = grid.filter((d) => d[2] === code);
    goldDots += own.length || 1;
    if (!own.length) fallbacks += 1;
    const d = own.length ? own.map((p) => dot(p[0], p[1])).join("") : dot(known[code].cx, known[code].cy);
    return { code, name: known[code].name, d, cx: known[code].cx };
  })
  .sort((a, b) => a.cx - b.cx); // west to east, the order the dots fade in

const names = groups.map((g) => g.name).sort((a, b) => a.localeCompare(b));
const count = groups.length;
const strokeWidth = world.r * 2;

console.log(`[countryMap] ${count} countries, ${goldDots} gold dots (${fallbacks} centroid fallbacks), ${grid.length} grid dots, source ${data.live ? "live" : `snapshot ${data.fetched_at}`}`);
---
<div class="bc-map mt-4" data-open="false">
  <button
    type="button"
    class="bc-map__button group inline-flex flex-wrap items-center gap-x-3 gap-y-1 text-left text-sm text-white hover:text-gold-500 transition-colors"
    aria-expanded="false"
    aria-controls="bc-map-panel"
  >
    <span class="inline-flex items-center gap-2">
      <span>Cards made in {count} countries</span>
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="bc-map__chevron" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
    </span>
    <span class="font-mono text-[10px] tracking-[0.15em] uppercase text-surface-500">Click for the map</span>
  </button>

  <div id="bc-map-panel" class="bc-map__panel">
    <div class="bc-map__inner">
      <div class="bc-map__content">
        <div class="flex items-start justify-between gap-4 mb-3">
          <span class="block font-mono text-[10px] tracking-[0.2em] uppercase text-surface-500">Where cards were made</span>
          <button type="button" class="bc-map__close -mt-1.5 -mr-1.5 p-1.5 text-surface-500 hover:text-white transition-colors" aria-label="Close the map">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
          </button>
        </div>
        <svg viewBox={`0 0 ${world.w} ${world.h}`} class="block w-full h-auto" role="img" aria-labelledby="bc-map-title">
          <title id="bc-map-title">World map with the countries where a card was made marked in gold</title>
          <path class="bc-map__base" d={baseD} fill="none" stroke="rgba(255,255,255,0.14)" stroke-width={strokeWidth} stroke-linecap="round" />
          {groups.map((g, i) => (
            <path class="bc-map__hl" style={`--i:${i}`} d={g.d} fill="none" stroke="#D4A853" stroke-width={strokeWidth} stroke-linecap="round"><title>{g.name}</title></path>
          ))}
        </svg>
        <p class="mt-4 text-xs text-surface-400 leading-relaxed">{names.join(", ")}</p>
      </div>
    </div>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>(".bc-map");
  const button = root?.querySelector<HTMLButtonElement>(".bc-map__button");
  const close = root?.querySelector<HTMLButtonElement>(".bc-map__close");
  if (root && button && close) {
    let open = false;

    const render = () => {
      root.dataset.open = String(open);
      button.setAttribute("aria-expanded", String(open));
    };

    button.addEventListener("click", () => {
      open = !open;
      render();
    });

    close.addEventListener("click", () => {
      open = false;
      render();
      button.focus();
    });

    root.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && open) {
        open = false;
        render();
        button.focus();
      }
    });
  }
</script>
