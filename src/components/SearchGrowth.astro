---
/**
 * Visitors from search per month on /using-data-to-build-with-ai (S28; redrawn
 * S30, 9/21/26, as plain bars at Gabriel's ask: a chart is just the chart, so
 * the work markers and their key moved into the post's prose). Same geometry,
 * viewBox and CSS classes as MonthlyCards (global.css, MONTHLY CARDS) so the
 * two charts read as one system: gold flat bars, the value above every bar,
 * the month below, one hairline baseline. Values from getBcMonthly()
 * (bc-monthly.json search_visitors, or the live API). The current month is
 * dimmer and labeled MTD, derived from fetched_at at build time.
 */
import { getBcMonthly } from "../lib/bcStats";

const data = await getBcMonthly();
const months = data.months;
if (!months.length) throw new Error("[searchGrowth] empty series");
if (months.some((m) => typeof m.search_visitors !== "number")) throw new Error("[searchGrowth] a month is missing search_visitors");

const currentKey = data.fetched_at.slice(0, 7);
const short = (m: string) =>
  new Date(`${m}-15T12:00:00Z`).toLocaleDateString("en-US", { month: "short", timeZone: "UTC" });
const long = (m: string) =>
  new Date(`${m}-15T12:00:00Z`).toLocaleDateString("en-US", { month: "long", year: "numeric", timeZone: "UTC" });
const fmt = (n: number) => n.toLocaleString("en-US");

const W = 640;
const H = 224;
const padX = 12;
const top = 30;
const baseline = 184;
const labelY = 208;
const slot = (W - padX * 2) / months.length;
const barW = Math.round(slot * 0.62);
const max = Math.max(1, ...months.map((m) => m.search_visitors));

const bars = months.map((m, i) => {
  const h = Math.max(2, Math.round(((baseline - top) * m.search_visitors) / max));
  const x = Math.round(padX + slot * i + (slot - barW) / 2);
  const partial = m.month === currentKey;
  return { ...m, i, x, y: baseline - h, h, cx: x + barW / 2, partial, label: short(m.month) };
});

const desc =
  `Visitors from a search engine per month since ${long(months[0].month)}: ` +
  bars.map((b) => `${long(b.month)} ${fmt(b.search_visitors)}${b.partial ? " month to date" : ""}`).join(", ") +
  ".";

console.log(`[searchGrowth] ${months.length} months, last ${currentKey} ${fmt(bars[bars.length - 1].search_visitors)}${bars[bars.length - 1].partial ? " MTD" : ""}, max ${max}`);
---
<figure class="bc-bars mt-6 border border-white/[0.08] bg-surface-950 p-4 md:p-5">
  <figcaption class="block font-mono text-[11px] tracking-[0.2em] uppercase text-surface-500 mb-3">Visitors from search per month</figcaption>
  <svg viewBox={`0 0 ${W} ${H}`} class="block w-full h-auto" role="img" aria-labelledby="sg-title sg-desc">
    <title id="sg-title">Visitors from search per month on birthday-cards.ai</title>
    <desc id="sg-desc">{desc}</desc>
    <line x1={padX} x2={W - padX} y1={baseline} y2={baseline} stroke="rgba(255,255,255,0.14)" stroke-width="1" />
    {bars.map((b) => (
      <g class="bc-bars__col" style={`--i:${b.i}`}>
        <rect class:list={["bc-bars__bar", { "bc-bars__bar--partial": b.partial }]} x={b.x} y={b.y} width={barW} height={b.h} fill="#D4A853" />
        <text class="bc-bars__value" x={b.cx} y={b.y - 9} text-anchor="middle">{fmt(b.search_visitors)}</text>
        <text class="bc-bars__month" x={b.cx} y={labelY} text-anchor="middle">{b.label}{b.partial ? " MTD" : ""}</text>
      </g>
    ))}
  </svg>
</figure>
