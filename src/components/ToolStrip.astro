---
/**
 * The tools behind birthday-cards.ai, as five short rows (S30, 9/21/26): a
 * mono label left, the names as the same hairline chips the page uses for the
 * connected sources. Rows and names come from how-data.ts tools, the list
 * that also bolds each name in the post, so the graphic and the prose cannot
 * disagree. No arrows, no lanes.
 */
import { tools, toolGroups } from "../data/how-data";

const rows = toolGroups.map((g) => ({ group: g, names: tools.filter((t) => t.group === g).map((t) => t.name) }));
for (const r of rows) if (!r.names.length) throw new Error(`[toolStrip] empty group: ${r.group}`);
---
<figure class="mt-6 border border-white/[0.08] bg-surface-950 p-4 md:p-5">
  <dl class="grid grid-cols-[5.5rem_1fr] gap-x-4 gap-y-3 items-baseline">
    {rows.map((r) => (
      <>
        <dt class="font-mono text-[11px] tracking-[0.2em] uppercase text-surface-500">{r.group}</dt>
        <dd class="flex flex-wrap gap-2">
          {r.names.map((n) => (
            <span class="border border-white/[0.08] px-2 py-1 font-mono text-[11px] tracking-[0.05em] text-surface-200">{n}</span>
          ))}
        </dd>
      </>
    ))}
  </dl>
</figure>
