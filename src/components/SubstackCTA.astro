---
import { socialLinks } from "../config/site";
---
<section class="py-10 px-6 md:px-12 lg:px-16 border-b border-white/[0.06]">
  <div class="max-w-7xl mx-auto flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4" data-reveal>
    <div class="flex items-center gap-4">
      <span class="label">Newsletter</span>
      <p class="text-sm text-surface-300">I write about this work on Substack. What worked, what did not, and what it cost.</p>
    </div>
    <a href={socialLinks.substack} target="_blank" rel="noreferrer" class="group inline-flex items-center gap-2 text-sm text-white hover:text-gold-500 transition-colors flex-shrink-0">
      <span>Read the newsletter</span>
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6m-11 5L21 3m-3 10v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" /></svg>
    </a>
  </div>
</section>
