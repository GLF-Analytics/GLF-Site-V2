# Build-time only. Never commit real values. Without these the build uses src/data/bc-stats.json.
VERCEL_ANALYTICS_TOKEN=
VERCEL_TEAM_ID=
BC_PROJECT_ID=

# Runtime only (the /api/warehouse-suggest function). Set these in Vercel >
# Settings > Environment Variables, never in a committed file: this repo is public.
# Without them the warehouse survey picks a stack by rules and says so.
ANTHROPIC_API_KEY=
WAREHOUSE_AI_ENABLED=
# Optional. Defaults to claude-opus-5.
WAREHOUSE_AI_MODEL=
