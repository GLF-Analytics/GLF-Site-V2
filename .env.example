# Build-time only. Never commit real values. Without these the build uses src/data/bc-stats.json.
VERCEL_ANALYTICS_TOKEN=
VERCEL_TEAM_ID=
BC_PROJECT_ID=

# Runtime only (the /api/warehouse-suggest function). Set these in Vercel >
# Settings > Environment Variables, never in a committed file: this repo is public.
# Without them the warehouse survey picks a stack by rules and says so.
ANTHROPIC_API_KEY=
WAREHOUSE_AI_ENABLED=
# Optional. Defaults to claude-opus-5.
WAREHOUSE_AI_MODEL=

# Runtime only (the /api/warehouse-report function, S23). All in Vercel, never committed.
# Off until LEAD_CAPTURE_ENABLED=true AND RESEND_API_KEY are set: the page then falls back to a mailto.
LEAD_CAPTURE_ENABLED=
RESEND_API_KEY=
# Optional. Defaults to "GLF Analytics <reports@glfanalytics.com>"; the domain must be verified in Resend.
RESEND_FROM=
# Optional. The audience that gets the ticked "occasional notes" opt-ins.
RESEND_AUDIENCE_ID=
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
# Optional. Defaults to Leads.
AIRTABLE_LEADS_TABLE=
# Optional. Defaults to the site's contact address: reply-to and the lead notification.
GABRIEL_EMAIL=
# The postal line in the report footer (CAN-SPAM). A PO box or virtual mailbox, never a home address.
GLF_POSTAL_ADDRESS=
# Dev only: skip every network call and write the rendered email to .dry-run/.
LEAD_DRY_RUN=
